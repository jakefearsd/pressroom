# Taken from http://gary-rowe.com/agilestack/2012/10/12/a-gitignore-file-for-intellij-and-eclipse-with-maven/
#
# Eclipse
.classpath
.project
.settings/

# Intellij
.idea/
*.iml
*.iws

# NetBeans
nb-configuration.xml
nbproject

# Mac
.DS_Store

# Maven
log/
target/

velocity.log

tomcat-base
docker/postgresql-data
docker/roller-data
it-selenium/overlays/
*.log
*.log.gz
logs/
app/logs/
socket:*

# Selenide writes failure screenshots and page dumps here (Configuration.reportsFolder
# defaults to build/reports/tests, not target/).
it-selenium/build/
.claude/worktrees/

# Production deployment secrets -- operator-created from the .example
# templates in deploy/, never committed (see docker-compose.prod.yml).
/.env
deploy/.env.test
deploy/config/roller-production.properties

.superpowers/

# Local dev admin credential, generated by ./roller. Never commit.
.roller-dev-secret

# Editor JS build (Task A1): frontend-maven-plugin downloads Node here and
# npm installs dependencies here; both are per-machine and reproducible from
# app/frontend/package.json + package-lock.json, which ARE committed.
app/frontend/node_modules/
app/frontend/node/
# The editor and reader bundles: build outputs that have to sit under the
# webapp root, because that is the only static location this deployment
# serves (see app/frontend/build.mjs).
app/src/main/webapp/pressroom-ui/scripts/roller-editor.js
app/src/main/webapp/pressroom-ui/scripts/roller-content.js
