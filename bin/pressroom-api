#!/usr/bin/env bash
# pressroom-api -- command-line client for Roller's automation API.
#
# Configuration precedence: --url/--token flags (highest), then
# PRESSROOM_API_URL / PRESSROOM_API_TOKEN, then ~/.pressroom/credentials (lowest).
# The environment layer is what makes this usable from CI without an
# interactive login; the flags exist so a one-off call against a second
# instance never has to touch either the environment or the credentials
# file. Each of the two variables is resolved independently at that
# precedence -- see load_credentials -- so supplying only one of them (e.g.
# --url with no --token) still lets the other fall through to the
# environment or the file rather than one present value dragging the other
# down with it.
#
# A partial run against a live blog is worse than no run: set -euo pipefail
# means any unset variable or failing command stops the script immediately
# rather than continuing on with half-applied state.
set -euo pipefail

CRED_FILE="${PRESSROOM_CREDENTIALS:-$HOME/.pressroom/credentials}"

die() { printf '%s\n' "$*" >&2; exit 1; }

# Called as `need_arg "$@"` from a flag's case branch, before reading $2: a
# flag given last with no value is refused by name instead of dying on set -u
# with "$2: unbound variable".
need_arg() { [ $# -ge 2 ] || die "$1 needs a value."; }

# Every temp file this script ever creates (a netrc file during login, an
# upload response body during a multipart upload) is registered here and
# removed on ANY exit path, including a set -e abort partway through --
# a plain trailing `rm -f` only runs on the success path, which is exactly
# the path least likely to leave a credential or a stale response sitting
# in /tmp.
_cleanup_files=()
_register_cleanup() { _cleanup_files+=("$1"); }
_run_cleanup() {
    local f
    if [ "${#_cleanup_files[@]}" -gt 0 ]; then
        for f in "${_cleanup_files[@]}"; do
            [ -n "$f" ] && rm -f "$f"
        done
    fi
}
trap _run_cleanup EXIT

require_tools() {
    command -v curl >/dev/null 2>&1 || die "pressroom-api needs curl on PATH."
    command -v jq   >/dev/null 2>&1 || die "pressroom-api needs jq on PATH."
}

# Reads NAME's value out of the credentials file's own "NAME=value" lines
# without sourcing the whole file -- sourcing would let a value the file
# carries clobber one already supplied by a flag or the environment (both
# higher precedence), instead of only filling in what is still missing.
_cred_file_value() {
    local name="$1"
    [ -f "$CRED_FILE" ] || return 0
    sed -n "s/^${name}=//p" "$CRED_FILE" | tail -n 1
}

load_credentials() {
    if [ -z "${PRESSROOM_API_URL:-}" ]; then
        PRESSROOM_API_URL="$(_cred_file_value PRESSROOM_API_URL)"
    fi
    if [ -z "${PRESSROOM_API_TOKEN:-}" ]; then
        PRESSROOM_API_TOKEN="$(_cred_file_value PRESSROOM_API_TOKEN)"
    fi
    if [ -z "${PRESSROOM_API_URL:-}" ] && [ -z "${PRESSROOM_CREDENTIALS:-}" ] \
        && [ ! -f "$CRED_FILE" ] && [ -f "$HOME/.roller/credentials" ]; then # rebrand:keep
        die "The credentials file moved. Run: mv ~/.roller ~/.pressroom" # rebrand:keep
    fi
    : "${PRESSROOM_API_URL:?No API URL. Run 'pressroom-api auth login --url ...' first.}"
    : "${PRESSROOM_API_TOKEN:?No API token. Run 'pressroom-api auth login --url ...' first.}"
}

# Issues one authenticated request against /api/v1<path>. Extra args (e.g.
# -d, --data-binary, -F) are forwarded to curl verbatim, before the URL.
# --fail-with-body means an API error body (a problem+json document) is
# printed rather than swallowed -- a CLI that prints nothing on a 400 is
# useless for debugging.
api() {
    local method="$1" path="$2"; shift 2
    curl -sS --fail-with-body \
        -X "$method" \
        -H "Authorization: Bearer ${PRESSROOM_API_TOKEN:-}" \
        -H "Content-Type: application/json" \
        "$@" \
        "${PRESSROOM_API_URL}/api/v1${path}"
}

# Like api(), but does not force Content-Type: application/json -- used for
# the multipart upload, where curl's -F sets its own multipart content type.
api_raw() {
    local method="$1" path="$2"; shift 2
    curl -sS --fail-with-body \
        -X "$method" \
        -H "Authorization: Bearer ${PRESSROOM_API_TOKEN:-}" \
        "$@" \
        "${PRESSROOM_API_URL}/api/v1${path}"
}

# Reads --text-file F's content, or stdin when F is "-". Entry/preview bodies
# always flow through here rather than a shell argument, so large content
# (and content containing quotes, backslashes or newlines) never goes
# through shell argument handling.
read_text_file() {
    local file="$1"
    [ -n "$file" ] || die "--text-file is required."
    if [ "$file" = "-" ]; then
        cat
    else
        [ -f "$file" ] || die "No such file: $file"
        cat "$file"
    fi
}

# ------------------------------------------------------------------- auth

cmd_auth_login() {
    local url="" user="" password_stdin=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --url)  need_arg "$@"; url="$2";  shift 2 ;;
            --user) need_arg "$@"; user="$2"; shift 2 ;;
            --password-stdin) password_stdin=1; shift ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$url" ] || die "--url is required."
    [ -n "$user" ] || { printf 'Username: '; read -r user; }

    # The password is read once, sent once, and never stored. Only the returned
    # token is persisted -- the same shape as `gh auth login`.
    #
    # --password-stdin is the standard non-interactive idiom (`docker login`
    # uses it). The password crosses on stdin: never an argv entry, never an
    # environment variable, so it is safe for CI as well as for `./roller
    # token`. IFS= and -r keep leading/trailing whitespace and backslashes
    # intact -- a password is bytes, not a shell word.
    local password
    if [ "$password_stdin" -eq 1 ]; then
        IFS= read -r password || die "--password-stdin was given but stdin was empty."
        [ -n "$password" ] || die "--password-stdin read an empty password."
    else
        printf 'Password: '
        read -rs password
        printf '\n'
    fi

    # `curl -u user:password` would put the password on THIS PROCESS'S OWN
    # command line -- readable by any other local user via `ps -ef` or
    # /proc/<pid>/cmdline for the life of the request. A .netrc-style file,
    # created with a private mode and registered for cleanup on every exit
    # path (including a set -e abort if curl itself fails), is what
    # `curl --netrc-file` reads the credential from instead: the password
    # never becomes an argv element anywhere. There is no `-u` fallback --
    # not for a missing mktemp, not for anything.
    local host netrc_file
    host="${url#*://}"
    host="${host%%/*}"
    host="${host%%:*}"

    netrc_file="$(mktemp "${TMPDIR:-/tmp}/pressroom-api-netrc.XXXXXX")"
    chmod 600 "$netrc_file"
    _register_cleanup "$netrc_file"
    printf 'machine %s\nlogin %s\npassword %s\n' "$host" "$user" "$password" > "$netrc_file"
    unset password

    # This used to be `token=$(curl ... | jq -r '.token')` -- a bare
    # command-substitution assignment through a pipe, the exact shape
    # media_upload's own comment above warns about. On any login failure
    # (bad password, wrong URL, a 5xx) --fail-with-body makes curl exit 22;
    # `jq -r '.token'` then parses the perfectly valid {"detail":...} error
    # body, finds no .token, prints "null", and itself exits 0. `pipefail`
    # still reports the PIPELINE's status as curl's 22, so `set -e` aborted
    # the script right there -- before `rm -f`, before `die`, before
    # anything reached the terminal, because the informative body had been
    # captured into a variable instead of printed. Splitting the curl call
    # out of the pipe (capture the raw body, THEN run jq on it as a second,
    # separate step) and guarding the capture as an `if` condition fixes
    # both problems at once: set -e cannot fire on it, and the body survives
    # long enough to pull a `.detail` out of it for the error message.
    local login_response
    if ! login_response="$(curl -sS --fail-with-body \
        --netrc-file "$netrc_file" \
        -H "Content-Type: application/json" \
        -X POST "${url}/api/v1/tokens" \
        -d "$(jq -n --arg label "pressroom-api cli" '{label: $label, role: "ADMIN"}')")"; then
        rm -f "$netrc_file"
        local detail
        detail="$(printf '%s' "$login_response" | jq -r '.detail // empty' 2>/dev/null || true)"
        if [ -n "$detail" ]; then
            die "Login failed: $detail"
        fi
        die "Login failed."
    fi
    rm -f "$netrc_file"

    local token
    token="$(printf '%s' "$login_response" | jq -r '.token // empty' 2>/dev/null || true)"

    [ -n "$token" ] && [ "$token" != "null" ] || die "Login failed."

    mkdir -p "$(dirname "$CRED_FILE")"
    umask 077
    printf 'PRESSROOM_API_URL=%s\nPRESSROOM_API_TOKEN=%s\n' "$url" "$token" > "$CRED_FILE"
    chmod 600 "$CRED_FILE"
    printf 'Saved credentials to %s\n' "$CRED_FILE"
}

cmd_auth_status() {
    load_credentials
    api GET /me | jq .
}

# ---------------------------------------------------------------- entries

usage_entries() {
    cat <<'EOF'
  entries list    --weblog H [--status S] [--category C] [--tags T,T] [--text S] [--locale L]
                  [--limit N] [--offset N]
  entries get     --weblog H --id ID
  entries create  --weblog H --title T --text-file F [--publish] [--status S] [--category C]
                  [--tags T,T] [--pub-time T] [--meta-title T] [--search-description D]
                  [--canonical-url U] [--noindex true|false] [--featured-image-id ID]
                  [--og-image-id ID]
  entries patch   --weblog H --id ID [--title T] [--text-file F] [--status S] [--category C]
                  [--tags T,T] [--pub-time T] [--meta-title T] [--search-description D]
                  [--canonical-url U] [--noindex true|false] [--featured-image-id ID]
                  [--og-image-id ID]
  entries trash   --weblog H --id ID
  entries restore --weblog H --id ID
  entries delete-forever --weblog H --id ID
  entries preview --weblog H --text-file F [--id ID]
EOF
}

cmd_entries() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        list)    entries_list "$@" ;;
        get)     entries_get "$@" ;;
        create)  entries_create "$@" ;;
        patch)   entries_patch "$@" ;;
        trash)   entries_trash "$@" ;;
        restore) entries_restore "$@" ;;
        delete-forever) entries_delete_forever "$@" ;;
        preview) entries_preview "$@" ;;
        *) usage_entries; exit 1 ;;
    esac
}

entries_list() {
    local weblog="" status="" category="" tags="" text="" locale="" offset="" limit=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)   need_arg "$@"; weblog="$2";   shift 2 ;;
            --status)   need_arg "$@"; status="$2";   shift 2 ;;
            --category) need_arg "$@"; category="$2"; shift 2 ;;
            --tags)     need_arg "$@"; tags="$2";     shift 2 ;;
            --text)     need_arg "$@"; text="$2";     shift 2 ;;
            --locale)   need_arg "$@"; locale="$2";   shift 2 ;;
            --offset)   need_arg "$@"; offset="$2";   shift 2 ;;
            --limit)    need_arg "$@"; limit="$2";    shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."

    local args=(-G)
    [ -n "$status" ]   && args+=(--data-urlencode "status=$status")
    [ -n "$category" ] && args+=(--data-urlencode "category=$category")
    if [ -n "$tags" ]; then
        IFS=',' read -ra tag_array <<< "$tags"
        for t in "${tag_array[@]}"; do
            args+=(--data-urlencode "tags=$t")
        done
    fi
    [ -n "$text" ]     && args+=(--data-urlencode "text=$text")
    [ -n "$locale" ]   && args+=(--data-urlencode "locale=$locale")
    [ -n "$offset" ]   && args+=(--data-urlencode "offset=$offset")
    [ -n "$limit" ]    && args+=(--data-urlencode "limit=$limit")

    api GET "/weblogs/${weblog}/entries" "${args[@]}" | jq .
}

entries_get() {
    local weblog="" id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --id)     need_arg "$@"; id="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."
    api GET "/weblogs/${weblog}/entries/${id}" | jq .
}

# Builds the shared create/patch JSON body with jq -n --arg, never string
# concatenation -- an entry body containing a quote, a newline or a backslash
# is normal input, not an edge case, and concatenation would corrupt it
# silently.
entries_write_body() {
    local title="$1" text_file="$2" status="$3" category="$4" tags="$5" \
          pub_time="$6" meta_title="$7" search_description="$8" canonical_url="$9"
    shift 9
    local noindex="$1" featured_image_id="$2" og_image_id="$3"

    local text=""
    [ -n "$text_file" ] && text="$(read_text_file "$text_file")"

    local tags_json="null"
    if [ -n "$tags" ]; then
        IFS=',' read -ra tag_array <<< "$tags"
        tags_json="$(printf '%s\n' "${tag_array[@]}" | jq -R . | jq -s .)"
    fi

    local noindex_json="null"
    if [ -n "$noindex" ]; then
        case "$noindex" in
            true|false) noindex_json="$noindex" ;;
            *) die "--noindex must be true or false." ;;
        esac
    fi

    jq -n \
        --arg title "$title" \
        --arg text "$text" \
        --arg status "$status" \
        --arg category "$category" \
        --argjson tags "$tags_json" \
        --arg pubTime "$pub_time" \
        --arg metaTitle "$meta_title" \
        --arg searchDescription "$search_description" \
        --arg canonicalUrl "$canonical_url" \
        --argjson noindex "$noindex_json" \
        --arg featuredImageId "$featured_image_id" \
        --arg ogImageId "$og_image_id" \
        '{
            title: (if $title == "" then null else $title end),
            text: (if $text == "" then null else $text end),
            status: (if $status == "" then null else $status end),
            category: (if $category == "" then null else $category end),
            tags: $tags,
            pubTime: (if $pubTime == "" then null else $pubTime end),
            metaTitle: (if $metaTitle == "" then null else $metaTitle end),
            searchDescription: (if $searchDescription == "" then null else $searchDescription end),
            canonicalUrl: (if $canonicalUrl == "" then null else $canonicalUrl end),
            noindex: $noindex,
            featuredImageId: (if $featuredImageId == "" then null else $featuredImageId end),
            ogImageId: (if $ogImageId == "" then null else $ogImageId end)
        }'
}

entries_create() {
    local weblog="" title="" text_file="" publish="" status="" category="" tags="" \
          pub_time="" meta_title="" search_description="" canonical_url="" \
          noindex="" featured_image_id="" og_image_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)             need_arg "$@"; weblog="$2";             shift 2 ;;
            --title)              need_arg "$@"; title="$2";              shift 2 ;;
            --text-file)          need_arg "$@"; text_file="$2";           shift 2 ;;
            --publish)            publish=1;                shift 1 ;;
            --status)             need_arg "$@"; status="$2";              shift 2 ;;
            --category)           need_arg "$@"; category="$2";            shift 2 ;;
            --tags)               need_arg "$@"; tags="$2";                shift 2 ;;
            --pub-time)           need_arg "$@"; pub_time="$2";             shift 2 ;;
            --meta-title)         need_arg "$@"; meta_title="$2";           shift 2 ;;
            --search-description) need_arg "$@"; search_description="$2";   shift 2 ;;
            --canonical-url)      need_arg "$@"; canonical_url="$2";        shift 2 ;;
            --noindex)            need_arg "$@"; noindex="$2";              shift 2 ;;
            --featured-image-id)  need_arg "$@"; featured_image_id="$2";    shift 2 ;;
            --og-image-id)        need_arg "$@"; og_image_id="$2";          shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$title" ] || die "--title is required."
    [ -n "$text_file" ] || die "--text-file is required."
    if [ -n "$publish" ] && [ -z "$status" ]; then
        status="PUBLISHED"
    fi

    local body
    body="$(entries_write_body "$title" "$text_file" "$status" "$category" "$tags" \
        "$pub_time" "$meta_title" "$search_description" "$canonical_url" \
        "$noindex" "$featured_image_id" "$og_image_id")"

    api POST "/weblogs/${weblog}/entries" -d "$body" | jq .
}

entries_patch() {
    local weblog="" id="" title="" text_file="" status="" category="" tags="" \
          pub_time="" meta_title="" search_description="" canonical_url="" \
          noindex="" featured_image_id="" og_image_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)             need_arg "$@"; weblog="$2";             shift 2 ;;
            --id)                 need_arg "$@"; id="$2";                  shift 2 ;;
            --title)              need_arg "$@"; title="$2";               shift 2 ;;
            --text-file)          need_arg "$@"; text_file="$2";           shift 2 ;;
            --status)             need_arg "$@"; status="$2";              shift 2 ;;
            --category)           need_arg "$@"; category="$2";            shift 2 ;;
            --tags)               need_arg "$@"; tags="$2";                shift 2 ;;
            --pub-time)           need_arg "$@"; pub_time="$2";             shift 2 ;;
            --meta-title)         need_arg "$@"; meta_title="$2";           shift 2 ;;
            --search-description) need_arg "$@"; search_description="$2";   shift 2 ;;
            --canonical-url)      need_arg "$@"; canonical_url="$2";        shift 2 ;;
            --noindex)            need_arg "$@"; noindex="$2";              shift 2 ;;
            --featured-image-id)  need_arg "$@"; featured_image_id="$2";    shift 2 ;;
            --og-image-id)        need_arg "$@"; og_image_id="$2";          shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."

    local body
    body="$(entries_write_body "$title" "$text_file" "$status" "$category" "$tags" \
        "$pub_time" "$meta_title" "$search_description" "$canonical_url" \
        "$noindex" "$featured_image_id" "$og_image_id")"

    api PATCH "/weblogs/${weblog}/entries/${id}" -d "$body" | jq .
}

entries_trash() {
    local weblog="" id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --id)     need_arg "$@"; id="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."
    # No -o /dev/null: a 409 (e.g. "Entry is already trashed.") carries a
    # `detail` in its problem+json body that --fail-with-body exists to
    # surface -- discarding the body here would defeat that on the one
    # endpoint most likely to return a descriptive conflict. A successful
    # DELETE has no body at all, so nothing extra prints on the happy path.
    api DELETE "/weblogs/${weblog}/entries/${id}"
    printf 'Trashed %s\n' "$id"
}

entries_restore() {
    local weblog="" id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --id)     need_arg "$@"; id="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."
    api POST "/weblogs/${weblog}/entries/${id}/restore" | jq .
}

entries_delete_forever() {
    local weblog="" id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --id)     need_arg "$@"; id="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."
    # No -o /dev/null -- see entries_trash's comment; a 409 here ("Entry is
    # not trashed; trash it first.") is exactly the kind of detail a caller
    # needs to see, not discard.
    api POST "/weblogs/${weblog}/entries/${id}/delete-forever"
    printf 'Permanently deleted %s\n' "$id"
}

entries_preview() {
    local weblog="" id="" text_file=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)    need_arg "$@"; weblog="$2";    shift 2 ;;
            --id)        need_arg "$@"; id="$2";        shift 2 ;;
            --text-file) need_arg "$@"; text_file="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$text_file" ] || die "--text-file is required."

    local text body
    text="$(read_text_file "$text_file")"
    body="$(jq -n --arg text "$text" '{text: $text}')"

    local path="/weblogs/${weblog}/entries/preview" response
    if [ -n "$id" ]; then
        path="/weblogs/${weblog}/entries/${id}/preview"
    fi
    if ! response="$(api POST "$path" -d "$body")"; then
        printf '%s\n' "$response" >&2
        exit 1
    fi
    # The HTML alone on stdout, so `> post.html` keeps working; the advice
    # (inline colors, code blocks with no language) on stderr.
    jq -r '.html' <<<"$response"
    jq -r '.warnings[]? | "warning: " + .' <<<"$response" >&2
}

# ------------------------------------------------------------------ media

usage_media() {
    cat <<'EOF'
  media list       --weblog H [--dir D]
  media get        --weblog H --id ID
  media upload     --weblog H [--dir-id D] FILE...
  media patch      --weblog H --id ID [--alt-text TEXT] [--name N] [--focal-x X] [--focal-y Y] [--dir-id D]
  media delete     --weblog H --id ID
  media dirs       --weblog H
  media create-dir --weblog H --name N [--description D]
EOF
}

cmd_media() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        list)       media_list "$@" ;;
        get)        media_get "$@" ;;
        upload)     media_upload "$@" ;;
        patch)      media_patch "$@" ;;
        delete)     media_delete "$@" ;;
        dirs)       media_dirs "$@" ;;
        create-dir) media_create_dir "$@" ;;
        *) usage_media; exit 1 ;;
    esac
}

media_list() {
    local weblog="" dir=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --dir)    need_arg "$@"; dir="$2";    shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    if [ -n "$dir" ]; then
        api GET "/weblogs/${weblog}/media" -G --data-urlencode "dir=$dir" | jq .
    else
        api GET "/weblogs/${weblog}/media" | jq .
    fi
}

media_get() {
    local weblog="" id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --id)     need_arg "$@"; id="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."
    api GET "/weblogs/${weblog}/media/${id}" | jq .
}

# Multipart batch upload -- POST /v1/weblogs/{h}/media with one or more
# `file` parts. Responds 201 only when every file landed; 207 the moment any
# one did not. --fail-with-body only trips curl's own failure on 4xx/5xx, and
# 207 is a 2xx status, so a 207 body must be inspected for its own `failed`
# count -- this must NOT report success just because curl did not fail.
media_upload() {
    local weblog="" dir_id="" files=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --dir-id) need_arg "$@"; dir_id="$2"; shift 2 ;;
            --) shift; while [ $# -gt 0 ]; do files+=("$1"); shift; done ;;
            -*) die "Unknown option: $1" ;;
            *) files+=("$1"); shift ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ "${#files[@]}" -gt 0 ] || die "At least one file is required."

    local form_args=()
    for f in "${files[@]}"; do
        [ -f "$f" ] || die "No such file: $f"
        form_args+=(-F "file=@${f}")
    done
    [ -n "$dir_id" ] && form_args+=(-F "directoryId=${dir_id}")

    # A non-2xx here (any failed file causes 207, and 207 is deliberately
    # NOT curl's idea of success -- see the comment above -- but a hard
    # 4xx/5xx is also possible) makes --fail-with-body return curl exit 22.
    # A bare `status="$(cmd)"` assignment would let set -e abort the script
    # on that exit code BEFORE the body is ever read or printed, leaving the
    # real problem+json sitting unread in a temp file. Guarding the
    # assignment as an `if` condition is what keeps set -e from firing here,
    # the same way `load_credentials`'s `:` guard does elsewhere.
    local response_file status
    # No ".json" suffix after the X's: GNU mktemp allows a trailing suffix but
    # BSD/macOS mktemp hands the template straight to mkstemp(3), which requires
    # the last six characters to be XXXXXX and fails with "Invalid argument".
    # Nothing reads this file's extension.
    response_file="$(mktemp "${TMPDIR:-/tmp}/pressroom-api-upload.XXXXXX")"
    _register_cleanup "$response_file"
    if ! status="$(api_raw POST "/weblogs/${weblog}/media" "${form_args[@]}" \
        -o "$response_file" -w '%{http_code}')"; then
        : # curl's own non-2xx exit -- the body is still in $response_file.
    fi

    local body
    body="$(cat "$response_file")"
    rm -f "$response_file"

    # Printed on BOTH the success and failure path -- a caller must be able
    # to see why an upload failed, not just that it did.
    if ! printf '%s\n' "$body" | jq .; then
        printf '%s\n' "$body" >&2
    fi

    local failed
    failed="$(printf '%s\n' "$body" | jq -r '.failed // 0' 2>/dev/null || echo 0)"
    [ -n "$failed" ] || failed=0
    if [ "${status#2}" = "$status" ] || [ "$failed" != "0" ]; then
        die "Upload had failures (status $status, $failed file(s) failed); see results above."
    fi
}

media_patch() {
    local weblog="" id="" alt_text="" name="" focal_x="" focal_y="" dir_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)   need_arg "$@"; weblog="$2";   shift 2 ;;
            --id)       need_arg "$@"; id="$2";       shift 2 ;;
            --alt-text) need_arg "$@"; alt_text="$2"; shift 2 ;;
            --name)     need_arg "$@"; name="$2";     shift 2 ;;
            --focal-x)  need_arg "$@"; focal_x="$2";  shift 2 ;;
            --focal-y)  need_arg "$@"; focal_y="$2";  shift 2 ;;
            --dir-id)   need_arg "$@"; dir_id="$2";   shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."

    local focal_x_json="null" focal_y_json="null"
    [ -n "$focal_x" ] && focal_x_json="$focal_x"
    [ -n "$focal_y" ] && focal_y_json="$focal_y"

    local body
    body="$(jq -n \
        --arg altText "$alt_text" \
        --arg name "$name" \
        --arg directoryId "$dir_id" \
        --argjson focalX "$focal_x_json" \
        --argjson focalY "$focal_y_json" \
        '{
            altText: (if $altText == "" then null else $altText end),
            name: (if $name == "" then null else $name end),
            directoryId: (if $directoryId == "" then null else $directoryId end),
            focalX: $focalX,
            focalY: $focalY
        }')"

    api PATCH "/weblogs/${weblog}/media/${id}" -d "$body" | jq .
}

media_delete() {
    local weblog="" id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --id)     need_arg "$@"; id="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$id" ] || die "--id is required."
    # No -o /dev/null -- see entries_trash's comment.
    api DELETE "/weblogs/${weblog}/media/${id}"
    printf 'Deleted %s\n' "$id"
}

media_dirs() {
    local weblog=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    api GET "/weblogs/${weblog}/media/directories" | jq .
}

media_create_dir() {
    local weblog="" name="" description=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)      need_arg "$@"; weblog="$2";      shift 2 ;;
            --name)        need_arg "$@"; name="$2";        shift 2 ;;
            --description) need_arg "$@"; description="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    [ -n "$name" ] || die "--name is required."

    local body
    body="$(jq -n --arg name "$name" --arg description "$description" \
        '{name: $name, description: (if $description == "" then null else $description end)}')"
    api POST "/weblogs/${weblog}/media/directories" -d "$body" | jq .
}

# ------------------------------------------------------------------ audit

usage_audit() {
    cat <<'EOF'
  audit seo   --weblog H [--status S] [--offset N] [--limit N]
  audit media --weblog H
EOF
}

cmd_audit() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        seo)   audit_seo "$@" ;;
        media) audit_media "$@" ;;
        *) usage_audit; exit 1 ;;
    esac
}

audit_seo() {
    local weblog="" status="" offset="" limit=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            --status) need_arg "$@"; status="$2"; shift 2 ;;
            --offset) need_arg "$@"; offset="$2"; shift 2 ;;
            --limit)  need_arg "$@"; limit="$2";  shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."

    local args=(-G)
    [ -n "$status" ] && args+=(--data-urlencode "status=$status")
    [ -n "$offset" ] && args+=(--data-urlencode "offset=$offset")
    [ -n "$limit" ]  && args+=(--data-urlencode "limit=$limit")

    api GET "/weblogs/${weblog}/audit/seo" "${args[@]}" | jq .
}

audit_media() {
    local weblog=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    api GET "/weblogs/${weblog}/audit/media" | jq .
}

# ------------------------------------------------------------------ admin

usage_admin() {
    cat <<'EOF'
  admin rebuild-index --weblog H       (old name: admin reindex)
  admin flush-cache --weblog H
  admin regenerate-renditions --weblog H
  admin users list [--enabled true|false] [--offset N] [--limit N]
  admin users create --user-name N --email E [--screen-name S]
  admin users patch --user-name N [--email E] [--screen-name S] [--enabled true|false]
  admin config list
  admin config set NAME=VALUE [NAME=VALUE ...]
  admin weblogs list [--offset N] [--limit N]
  admin weblogs get --weblog H
  admin weblogs patch --weblog H [--name N] [--tagline T] [--active true|false] [--locale L]
                       [--timezone Z] [--entry-display-count N] [--email E]
EOF
}

cmd_admin() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        rebuild-index|reindex)   admin_action rebuild-index "$@" ;;
        flush-cache)             admin_action flush-cache "$@" ;;
        regenerate-renditions)   admin_action regenerate-renditions "$@" ;;
        users)   admin_users "$@" ;;
        config)  admin_config "$@" ;;
        weblogs) admin_weblogs "$@" ;;
        *) usage_admin; exit 1 ;;
    esac
}

admin_action() {
    local action="$1"; shift
    local weblog=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    api POST "/admin/weblogs/${weblog}/actions/${action}" | jq .
}

admin_users() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        list)   admin_users_list "$@" ;;
        create) admin_users_create "$@" ;;
        patch)  admin_users_patch "$@" ;;
        *) usage_admin; exit 1 ;;
    esac
}

admin_users_list() {
    local enabled="" offset="" limit=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --enabled) need_arg "$@"; enabled="$2"; shift 2 ;;
            --offset)  need_arg "$@"; offset="$2";  shift 2 ;;
            --limit)   need_arg "$@"; limit="$2";   shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    local args=(-G)
    [ -n "$enabled" ] && args+=(--data-urlencode "enabled=$enabled")
    [ -n "$offset" ]  && args+=(--data-urlencode "offset=$offset")
    [ -n "$limit" ]   && args+=(--data-urlencode "limit=$limit")
    api GET "/admin/users" "${args[@]}" | jq .
}

admin_users_create() {
    local user_name="" email="" screen_name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --user-name)   need_arg "$@"; user_name="$2";   shift 2 ;;
            --email)       need_arg "$@"; email="$2";       shift 2 ;;
            --screen-name) need_arg "$@"; screen_name="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$user_name" ] || die "--user-name is required."
    [ -n "$email" ] || die "--email is required."

    local body
    body="$(jq -n --arg userName "$user_name" --arg emailAddress "$email" --arg screenName "$screen_name" \
        '{userName: $userName, emailAddress: $emailAddress, screenName: (if $screenName == "" then null else $screenName end)}')"
    api POST "/admin/users" -d "$body" | jq .
}

admin_users_patch() {
    local user_name="" email="" screen_name="" enabled=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --user-name)   need_arg "$@"; user_name="$2";   shift 2 ;;
            --email)       need_arg "$@"; email="$2";       shift 2 ;;
            --screen-name) need_arg "$@"; screen_name="$2"; shift 2 ;;
            --enabled)     need_arg "$@"; enabled="$2";     shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$user_name" ] || die "--user-name is required."

    local enabled_json="null"
    [ -n "$enabled" ] && enabled_json="$enabled"

    local body
    body="$(jq -n --arg emailAddress "$email" --arg screenName "$screen_name" --argjson enabled "$enabled_json" \
        '{emailAddress: (if $emailAddress == "" then null else $emailAddress end),
          screenName: (if $screenName == "" then null else $screenName end),
          enabled: $enabled}')"
    api PATCH "/admin/users/${user_name}" -d "$body" | jq .
}

admin_config() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        list) api GET "/admin/config" | jq . ;;
        set)
            [ $# -gt 0 ] || die "admin config set needs at least one NAME=VALUE."
            local body="{}"
            for pair in "$@"; do
                case "$pair" in
                    *=*) : ;;
                    *) die "Expected NAME=VALUE, got: $pair" ;;
                esac
                local name="${pair%%=*}" value="${pair#*=}"
                body="$(printf '%s' "$body" | jq --arg name "$name" --arg value "$value" '. + {($name): $value}')"
            done
            api PATCH "/admin/config" -d "$body" | jq .
            ;;
        *) usage_admin; exit 1 ;;
    esac
}

admin_weblogs() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        list)  admin_weblogs_list "$@" ;;
        get)   admin_weblogs_get "$@" ;;
        patch) admin_weblogs_patch "$@" ;;
        *) usage_admin; exit 1 ;;
    esac
}

admin_weblogs_list() {
    local offset="" limit=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --offset) need_arg "$@"; offset="$2"; shift 2 ;;
            --limit)  need_arg "$@"; limit="$2";  shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    local args=(-G)
    [ -n "$offset" ] && args+=(--data-urlencode "offset=$offset")
    [ -n "$limit" ]  && args+=(--data-urlencode "limit=$limit")
    api GET "/weblogs" "${args[@]}" | jq .
}

admin_weblogs_get() {
    local weblog=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog) need_arg "$@"; weblog="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."
    api GET "/weblogs/${weblog}" | jq .
}

admin_weblogs_patch() {
    local weblog="" name="" tagline="" active="" locale="" timezone="" entry_display_count="" email=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --weblog)              need_arg "$@"; weblog="$2";              shift 2 ;;
            --name)                need_arg "$@"; name="$2";                shift 2 ;;
            --tagline)             need_arg "$@"; tagline="$2";              shift 2 ;;
            --active)              need_arg "$@"; active="$2";               shift 2 ;;
            --locale)              need_arg "$@"; locale="$2";               shift 2 ;;
            --timezone)            need_arg "$@"; timezone="$2";             shift 2 ;;
            --entry-display-count) need_arg "$@"; entry_display_count="$2";  shift 2 ;;
            --email)               need_arg "$@"; email="$2";                shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done
    [ -n "$weblog" ] || die "--weblog is required."

    local active_json="null" count_json="null"
    [ -n "$active" ] && active_json="$active"
    [ -n "$entry_display_count" ] && count_json="$entry_display_count"

    local body
    body="$(jq -n \
        --arg name "$name" --arg tagline "$tagline" --arg locale "$locale" \
        --arg timeZone "$timezone" --arg emailAddress "$email" \
        --argjson active "$active_json" --argjson entryDisplayCount "$count_json" \
        '{
            name: (if $name == "" then null else $name end),
            tagline: (if $tagline == "" then null else $tagline end),
            locale: (if $locale == "" then null else $locale end),
            timeZone: (if $timeZone == "" then null else $timeZone end),
            emailAddress: (if $emailAddress == "" then null else $emailAddress end),
            active: $active,
            entryDisplayCount: $entryDisplayCount
        }')"
    api PATCH "/weblogs/${weblog}" -d "$body" | jq .
}

# -------------------------------------------------------------------- misc

usage_auth() {
    cat <<'EOF'
  auth login --url URL [--user NAME] [--password-stdin]
  auth status
EOF
}

usage() {
    cat <<'EOF'
pressroom-api -- Roller automation API client

  [--url URL] [--token TOKEN] <command> ...
      Global overrides, parsed before the command -- highest-precedence
      configuration tier, above PRESSROOM_API_URL/PRESSROOM_API_TOKEN and above
      ~/.pressroom/credentials. Lets a one-off call reach a second instance
      without touching the environment or the stored credentials file.

  auth login --url URL [--user NAME] [--password-stdin]
                                       mint and store a token; --password-stdin
                                       reads the password from stdin instead of
                                       prompting, for scripts and CI
  auth status                          show who the stored token belongs to

  entries list    --weblog H [--status S] [--limit N]
  entries create  --weblog H --title T --text-file F [--publish] [SEO flags]
  entries patch   --weblog H --id ID [--search-description D] [--meta-title T]
  entries preview --weblog H --text-file F

  media upload --weblog H [--dir-id D] FILE...
  media patch  --weblog H --id ID [--alt-text TEXT] [--dir-id D]

  audit seo   --weblog H
  audit media --weblog H

  admin rebuild-index --weblog H
  admin flush-cache --weblog H
  admin regenerate-renditions --weblog H

Run 'pressroom-api <group> --help' to see every subcommand of a group and its
flags (groups: auth, entries, media, audit, admin).
EOF
}

main() {
    require_tools

    # --url/--token are the highest-precedence configuration tier (see the
    # file header), parsed here before the command name so any group can be
    # reached against a one-off URL/token without touching the environment
    # or ~/.pressroom/credentials. Only recognised in this leading position --
    # a subcommand's own flags are parsed by that subcommand.
    while [ $# -gt 0 ]; do
        case "$1" in
            --url|--token)
                local flag="$1"
                [ $# -ge 2 ] || die "$flag requires a value."
                # A caller who forgot the value entirely --
                # `pressroom-api --url auth login --weblog h` -- would otherwise
                # silently set PRESSROOM_API_URL="auth", treat "login" as the
                # top-level command, and fail with a generic usage message
                # that never hints the flag ate the command. Refuse it here
                # instead, while the actual mistake is still visible.
                case "$2" in
                    auth|entries|media|audit|admin)
                        die "$flag is missing its value -- got the command '$2' instead. Did you forget the URL/token argument?"
                        ;;
                esac
                if [ "$flag" = "--url" ]; then
                    PRESSROOM_API_URL="$2"
                else
                    PRESSROOM_API_TOKEN="$2"
                fi
                shift 2
                ;;
            *) break ;;
        esac
    done

    [ $# -gt 0 ] || { usage; exit 1; }
    local group="$1"; shift
    case "$group" in
        auth)
            local sub="${1:-}"; shift || true
            case "$sub" in
                login)  cmd_auth_login "$@" ;;
                status) cmd_auth_status ;;
                -h|--help|help) usage_auth ;;
                *) usage; exit 1 ;;
            esac
            ;;
        entries|media|audit|admin)
            # Help needs no credentials, and asking for it is not a usage error.
            case "${1:-}" in
                -h|--help|help) "usage_${group}"; exit 0 ;;
            esac
            load_credentials; "cmd_${group}" "$@" ;;
        -h|--help|help) usage ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
