<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apache.roller</groupId>
    <artifactId>roller-project</artifactId>
    <version>0.1.17</version>
    <packaging>pom</packaging>

    <name>Roller</name>
    <description>
        Roller is an open source multi-user blog server built with Spring MVC,
        Velocity, JPA/EclipseLink, and PostgreSQL.
    </description>
    <url>https://github.com/jakefearsd/roller</url>
    <inceptionYear>2002</inceptionYear>

    <scm>
        <url>https://github.com/jakefearsd/roller</url>
        <connection>scm:git:git://github.com/jakefearsd/roller.git</connection>
        <developerConnection>scm:git:git@github.com:jakefearsd/roller.git</developerConnection>
    </scm>

    <properties>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <testcontainers.version>2.0.5</testcontainers.version>
        <maven-surefire.version>3.6.0</maven-surefire.version>

        <!-- See the comment on surefire's skipTests in app/pom.xml for what
             this is and why it is not spelled skipTests.

             It DEFAULTS TO ${skipTests} rather than to false, and that is a
             bug fix, not a flourish: naming skipTests in surefire's <configuration>
             makes the pom's value win over the command line, so wiring a bare
             `false` there silently broke `mvn ... -DskipTests` for this module
             (surefire ran the suite anyway, and the only sign was a build that
             failed on a test the user had asked to skip). Chaining the default
             keeps -DskipTests working exactly as it always did, while
             -DskipUnitTests stays the narrower opt-in that leaves failsafe
             alone. -->
        <skipTests>false</skipTests>
        <skipUnitTests>${skipTests}</skipUnitTests>

        <!-- JaCoCo coverage gate (jacoco:check on verify). The ratchet is ACTIVE:
             these floors are measured minus a 0.01 margin, and later stages only
             ever raise them, never lower them. Targets are documented in
             CLAUDE.md.

             Measured after W2 (the minimalism program's second subtraction
             wave): LINE 0.8705, BRANCH 0.7958.

             BRANCH moved 0.7800 to 0.7900 there. LINE deliberately did NOT
             move, because at 0.8705 against a 0.8700 floor it was binding to
             within five hundredths of a point: a ratchet with no slack fails
             the build for one uncovered line whatever the change was about.

             That reasoning has since expired, and leaving the floors alone on
             the strength of it is why both drifted into enforcing nothing.
             Re-measured 2026-09-08 on a full `mvn clean verify -Pit`: LINE
             0.9142, BRANCH 0.8458, i.e. 4.4 and 5.6 points of slack, gained
             across the DI, redirects and rendering-perf waves without either
             floor moving. The condition the W2 comment named (no slack) is
             the opposite of the situation now, so both move.

             Set a few tenths under measured, NOT at it: the margin is what
             stops an unrelated change failing for the one uncovered line it
             happened to add, which is the failure mode the paragraph above
             is really about. 0.9100 leaves ~85 lines of headroom, 0.8400
             leaves ~41 branches. Coverage of NEW work remains the diff
             gate's job (bin/check-diff-coverage.sh, ~90% of changed lines);
             this floor's job is only to stop the whole-codebase number
             sliding back.

             Raised 2026-09-28 after a test-only coverage wave (453 lines,
             nine commits of characterisation tests): measured LINE 0.9377,
             BRANCH 0.8722 on `mvn -pl app clean verify` without cwebp.
             Floors keep the same headroom as the 2026-09-08 raise: 0.9330
             leaves ~95 lines, 0.8670 leaves ~37 branches. -->
        <jacoco.line.minimum>0.9330</jacoco.line.minimum>
        <jacoco.branch.minimum>0.8670</jacoco.branch.minimum>
        <jacoco.check.skip>false</jacoco.check.skip>

        <quality.check.skip>false</quality.check.skip>
    </properties>

    <modules>
        <module>app</module>
    </modules>

    <profiles>
        <!-- Browser integration tests. Kept out of the default build because they
             deploy the WAR to a downloaded Tomcat against a PostgreSQL container and
             drive a real Chrome, costing minutes rather than seconds.

                 mvn verify -Pit

             Requires Docker and Google Chrome on the host. -->
        <profile>
            <id>it</id>
            <modules>
                <module>it-selenium</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <!-- Java 25. Also asserted by maven-enforcer below (which
                             checks the JVM actually running the build, not just
                             the bytecode target), by the CI matrix in
                             .github/workflows/main.yml, and by the digest-pinned
                             temurin-25 images in Dockerfile. Moving the language
                             level means moving all four. -->
                        <release>25</release>
                        <fork>true</fork>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <!-- -options silences the bootclasspath/release advisory;
                                 -processing silences "no processor claimed this token"
                                 for the annotations only frameworks read at runtime.
                                 (This pair predates the Spring MVC migration and was
                                 attributed to Struts' TagAnnotationProcessor, which
                                 has not been a dependency since.) -->
                            <arg>-Xlint:-options</arg>
                            <arg>-Xlint:-processing</arg>
                            <!-- -path is classpath housekeeping, not a code defect.
                                 it-selenium has no main sources, so its own
                                 target/classes never exists and javac warns "bad
                                 path element" on every clean build; with
                                 failOnWarning that broke the browser-IT build. -->
                            <arg>-Xlint:-path</arg>
                            <!-- -this-escape is the javac twin of SpotBugs
                                 MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR, which
                                 config/spotbugs/exclude.xml already excludes as a
                                 family: template methods called from constructors
                                 are how the servlet and manager hierarchies are
                                 written, and most sites are JPA entities, which
                                 the JPA spec forbids making final (class or
                                 method), so the usual fix is unavailable. The two
                                 gates must not disagree. -->
                            <arg>-Xlint:-this-escape</arg>
                        </compilerArgs>
                        <!-- Any other warning fails the build: a deprecation, an
                             unused try resource or a dangling doc comment is
                             fixed (or suppressed at the site, with a reason),
                             never left to scroll past. QualityGatePomTest pins
                             this and the closed set of disabled lints. -->
                        <failOnWarning>true</failOnWarning>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-idea-plugin</artifactId>
                    <version>2.2.1</version>
                    <configuration>
                        <downloadSources>true</downloadSources>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.22.0</version>
                    <configuration>
                        <rulesUri>file:version-rules.xml</rulesUri>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>2.0.2</version>
                    <configuration>
                        <!-- Pinned exactly: the bundle is built on CI and on every laptop
                             from this runtime, and a floating major would move the
                             output under everyone. Downloaded once into app/frontend/node
                             (git-ignored); only the first build needs the network. -->
                        <nodeVersion>v24.21.0</nodeVersion>
                        <installDirectory>${project.basedir}/frontend</installDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/config/pmd/ruleset.xml</ruleset>
                        </rulesets>
                        <targetJdk>25</targetJdk>
                        <includeTests>false</includeTests>
                        <printFailingErrors>true</printFailingErrors>
                        <failOnViolation>true</failOnViolation>
                        <skip>${quality.check.skip}</skip>
                        <!-- CPD: 110 tokens, lowered from 200 after a deliberate
                             triage pass. 200 was chosen because 100 found twenty
                             blocks; the trouble is that it also missed real ones. Two
                             rules duplicated across a routing/parsing boundary sat at
                             roughly a hundred tokens each and were invisible to this
                             gate until someone read them: isLocale, copied between
                             WeblogRequest and WeblogRequestMapper, and the rendition
                             parser copied inside ThemeMetadataParser. Both are now
                             single-homed.

                             At 110 the tree is clean apart from blocks carrying
                             `CPD-OFF` with a stated reason. Anything new above 110
                             fails the build, which is the point: this threshold is
                             not a claim that smaller duplication is fine, only that
                             below it the gate costs more than it returns. -->
                        <minimumTokens>110</minimumTokens>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>7.27.0</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>7.27.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.4.1</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <includeTests>false</includeTests>
                        <failOnError>true</failOnError>
                        <skip>${quality.check.skip}</skip>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Java 25 is a DECISION, not drift: it is an LTS release (the
                 two-year cadence: 17, 21, 25; next is 29 in September 2027), and
                 this project stays on it until 29 rather than chasing the
                 six-month feature releases (26, 27, 28), which fall out of
                 support the day the next one ships. Do not propose or apply a
                 bump to a non-LTS Java. When 29 arrives, the seven pins to move
                 together are: this range, <release> above, PMD's <targetJdk>,
                 the java-version in all three .github/workflows, and both
                 temurin base images in Dockerfile.

                 Pins the JDK the build actually RUNS on. maven-compiler-plugin's
                 <release>25</release> only fixes the language level and bytecode
                 target: a JDK 26 or 30 toolchain compiles release-25 sources
                 happily and then runs the whole test suite on a JVM nobody
                 verified, which is how a green local build ships behaviour CI
                 never saw. [25,26) fails that at validate, with a message, rather
                 than at some puzzling runtime difference later. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-jdk-25</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Roller builds on JDK 25 only. See maven-compiler-plugin's &lt;release&gt;25&lt;/release&gt; above, the CI matrix in .github/workflows/main.yml, and the temurin-25 images in Dockerfile.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Coverage floor, ratcheted from measured coverage. Later
                         stages only ever raise jacoco.line.minimum /
                         jacoco.branch.minimum / the PACKAGE rule below, never
                         lower them. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>org.apache.roller.weblogger.ui.rendering</include>
                                        <include>org.apache.roller.weblogger.ui.rendering.servlets</include>
                                        <include>org.apache.roller.weblogger.ui.rendering.velocity</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Raised from 0.48 once the velocity package gained
                                                 its first direct tests. It had sat at exactly
                                                 0.4900 against this floor, so any macro change
                                                 that added an untested branch broke the build for
                                                 reasons unrelated to the change.

                                                 0.55 to 0.60 after W2, binding on velocity at
                                                 0.6190 (servlets 0.6667, rendering 0.8020).

                                                 0.60 to 0.80 on 2026-09-08. Re-measured: velocity
                                                 0.8806, servlets 0.8571, rendering 0.9447. The
                                                 whole area roughly gained 20 points while the
                                                 floor stood still, so at 0.60 this rule had 23
                                                 points of slack and enforced nothing at all.

                                                 The binding package is now servlets at 0.8571,
                                                 and that it is a 693-line package is why 0.80 is
                                                 safe to set: ~40 lines of headroom. Note that
                                                 ui.rendering.filters (0.8333) is LOWER but is not
                                                 in the includes above; it is one class and 18
                                                 lines, where a single uncovered line moves the
                                                 ratio 5.6 points, far too volatile to hang a
                                                 build gate on. Check the includes before reading
                                                 the lowest number in a coverage report as this
                                                 rule's binding constraint. -->
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit is no longer pinned here: app/pom.xml imports Spring
                 Boot 4.1's BOM, which manages junit-jupiter 6.0.3 (JUnit 6)
                 and junit-platform-launcher together. See app/pom.xml's
                 dependencyManagement comment for why the previous re-import
                 pattern existed and why it is gone. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
