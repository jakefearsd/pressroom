#!/usr/bin/env bash
# Pressroom development entry point.
#
# Usage:
#   ./pressroom dev        start postgres, apply migrations, run the app via spring-boot:run
#   ./pressroom db         start postgres only and apply migrations
#   ./pressroom migrate    apply pending migrations to the dev database
#   ./pressroom status     show which migrations have been applied
#   ./pressroom stop       stop the dev database (data is preserved)
#   ./pressroom reset      DESTROY the dev database volume, then recreate it
#   ./pressroom token      mint an API token for the dev admin (needs ./pressroom dev running)
#
# The dev database is the `postgres` service in docker-compose.yml. Its data
# lives in the pressroom-pgdata18 named volume and survives restarts; only
# `./pressroom reset` removes it.
set -euo pipefail

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
cd "${SCRIPT_DIR}"

DB_NAME="${DB_NAME:-pressroom}"
DB_APP_USER="${DB_APP_USER:-pressroom}"
DB_PORT="${DB_PORT:-${DEV_DB_PORT:-5433}}"

# The dev server runs at the ROOT, matching application.properties' shipped
# default -- `./pressroom dev` must reproduce the deployed url shape, or the one
# place a bad context assumption would show up is the one place nobody looks.
# Set DEV_CONTEXT_PATH=/pressroom (leading slash, no trailing) to reproduce a
# prefixed deployment locally. DEV_URL is what both `dev` and `token` print and
# pass around, so the two can never drift.
DEV_PORT="${DEV_PORT:-8083}"
DEV_CONTEXT_PATH="${DEV_CONTEXT_PATH:-}"
DEV_URL="http://localhost:${DEV_PORT}${DEV_CONTEXT_PATH}"

GREEN="\033[0;32m"
RED="\033[0;31m"
NC="\033[0m"
print_ok()  { echo -e "${GREEN}✓${NC} $*"; }
print_err() { echo -e "${RED}✗${NC} $*" >&2; }

usage() { awk '/^#!/{next} !/^#/{exit} {sub(/^# ?/,""); print}' "$0"; }

compose() {
    if docker compose version >/dev/null 2>&1; then
        docker compose "$@"
    else
        docker-compose "$@"
    fi
}

# Fails loudly on a missing prerequisite instead of letting it surface as a
# wrong diagnosis. macOS has no PostgreSQL client tools out of the box and
# Homebrew's libpq is keg-only (installed but NOT on PATH), so pg_isready is
# absent on a fresh Mac -- and because the readiness probe below sends its
# output to /dev/null, "command not found" used to be indistinguishable from
# "database not up yet". The script then blamed a perfectly healthy container.
# A plain string accumulator, not an array: under `set -u` bash 3.2 -- the very
# shell this function exists to keep working -- treats an EMPTY array expansion
# as an unbound variable, so the no-missing-tools path would itself abort.
require_tools() {
    local missing="" tool
    for tool in "$@"; do
        command -v "${tool}" >/dev/null 2>&1 || missing="${missing}${missing:+ }${tool}"
    done
    if [ -n "${missing}" ]; then
        print_err "Missing required command(s): ${missing}"
        print_err "  Linux: install docker and the postgresql-client package."
        print_err "  macOS: brew install --cask docker && brew install libpq"
        print_err "         libpq is keg-only, so put it on PATH too:"
        print_err '         echo "export PATH=\"$(brew --prefix)/opt/libpq/bin:\$PATH\"" >> ~/.zshrc'
        exit 1
    fi
}

start_db() {
    require_tools docker pg_isready
    compose up -d postgres
    echo -n "Waiting for PostgreSQL"
    # `sleep 1` is load-bearing, not politeness: pg_isready returns instantly on
    # connection-refused, so without it all 60 "retries" burn in well under a
    # second and the wait is milliseconds, not a minute. On Linux the named
    # volume usually means postgres is already accepting connections when
    # `compose up -d` returns, which hid this; a Mac's first run has to initdb
    # inside the Docker Desktop VM and reliably lost the race.
    for _ in $(seq 1 60); do
        if PGPASSWORD="${DB_APP_USER}" pg_isready \
                -h localhost -p "${DB_PORT}" -U "${DB_APP_USER}" -d "${DB_NAME}" -t 1 \
                >/dev/null 2>&1; then
            echo
            print_ok "PostgreSQL ready on localhost:${DB_PORT}"
            return 0
        fi
        echo -n "."
        sleep 1
    done
    echo
    print_err "PostgreSQL did not become ready. Check: compose logs postgres"
    exit 1
}

DEV_SECRET_FILE="${SCRIPT_DIR}/.pressroom-dev-secret"

# Loads .pressroom-dev-secret, generating it on first use.
#
# There is deliberately no branch that stops and asks: a fresh checkout runs
# ./pressroom dev and gets a working login plus the credential printed once. The
# file is git-ignored and is the source of truth for the dev admin password --
# a password changed through the UI is reverted by the next seed, which is the
# intended behaviour for a disposable local database whose whole purpose is a
# KNOWN credential.
load_dev_secret() {
    if [ ! -f "${DEV_SECRET_FILE}" ]; then
        local generated
        # `tr -dc ... </dev/urandom | head -c 32` is the obvious spelling and is
        # wrong here: head exits after 32 bytes, tr dies of SIGPIPE, and
        # `set -o pipefail` turns that into a silent exit 141 immediately after
        # migrations -- no error, no seed. Reading a bounded amount FIRST means
        # every stage sees EOF normally.
        generated="$(head -c 24 /dev/urandom | base64 | LC_ALL=C tr -dc 'A-Za-z0-9')"
        ( umask 077; printf 'PRESSROOM_DEV_ADMIN_PASSWORD=%s\n' "${generated}" > "${DEV_SECRET_FILE}" )
        print_ok "Generated ${DEV_SECRET_FILE} (mode 600, git-ignored)"
        echo "  Dev admin login:  admin / ${generated}"
        echo "  This is the only time it is printed. Edit the file to change it."
    fi
    # shellcheck disable=SC1090
    . "${DEV_SECRET_FILE}"
    : "${PRESSROOM_DEV_ADMIN_PASSWORD:?${DEV_SECRET_FILE} has no PRESSROOM_DEV_ADMIN_PASSWORD}"
}

# Applies bin/db/seed-dev-data.sql. The password goes in as a psql variable,
# never interpolated into SQL text.
seed_dev_data() {
    load_dev_secret
    PGPASSWORD="${DB_APP_USER}" psql \
        --no-psqlrc --quiet --set ON_ERROR_STOP=1 \
        -h localhost -p "${DB_PORT}" -U "${DB_APP_USER}" -d "${DB_NAME}" \
        -v devpw="${PRESSROOM_DEV_ADMIN_PASSWORD}" \
        -f "${SCRIPT_DIR}/bin/db/seed-dev-data.sql" >/dev/null
    print_ok "Dev admin seeded (user: admin)"
}

run_migrations() {
    require_tools psql
    DB_NAME="${DB_NAME}" DB_APP_USER="${DB_APP_USER}" \
        PGHOST=localhost PGPORT="${DB_PORT}" PGUSER="${DB_APP_USER}" \
        PGPASSWORD="${DB_APP_USER}" \
        bin/db/migrate.sh "$@"
}

case "${1:-dev}" in
    -h|--help|help)
        usage
        ;;
    db)
        start_db
        run_migrations
        seed_dev_data
        ;;
    dev)
        start_db
        run_migrations
        seed_dev_data
        print_ok "Starting Pressroom on ${DEV_URL}"
        # process-test-resources runs first so pressroom-boot-dev.properties is
        # filtered into target/test-classes before spring-boot:run starts the
        # app; without it, ${basedir}-style filtering never happens and the
        # custom config points at a file that doesn't exist yet.
        mvn -ntp -pl app process-test-resources spring-boot:run \
            -Dspring-boot.run.arguments="--server.port=${DEV_PORT} --server.servlet.context-path=${DEV_CONTEXT_PATH:-/}" \
            -Dspring-boot.run.jvmArguments="-Dpressroom.custom.config=${SCRIPT_DIR}/app/target/test-classes/pressroom-boot-dev.properties"
        ;;
    migrate)
        run_migrations
        ;;
    status)
        run_migrations --status
        ;;
    stop)
        compose stop postgres
        print_ok "Dev database stopped (data preserved)"
        ;;
    reset)
        echo "This DESTROYS the dev database and all its content."
        read -r -p "Type 'yes' to continue: " confirm
        if [[ "${confirm}" != "yes" ]]; then
            echo "Aborted."
            exit 1
        fi
        compose down -v
        start_db
        run_migrations
        seed_dev_data
        print_ok "Dev database recreated"
        ;;
    token)
        load_dev_secret
        printf '%s\n' "${PRESSROOM_DEV_ADMIN_PASSWORD}" | \
            bin/pressroom-api auth login \
                --url "${DEV_URL}" \
                --user admin \
                --password-stdin
        ;;
    *)
        print_err "Unknown command: ${1}"
        usage
        exit 2
        ;;
esac
