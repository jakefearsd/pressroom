<?xml version="1.0"?>
<ruleset name="Roller"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Roller's PMD gate: PMD's own quickstart set plus the security category,
        minus six rules, plus 21 defect-finding rules chosen 2026-10 from the
        other categories (see the groups below). Zero tolerance: see
        docs/superpowers/specs/2026-08-18-static-analysis-quality-gates-design.md.

        A rule is excluded only when violating it is SYSTEMATICALLY not a defect
        in this architecture, never merely because there are a lot of them.
        Adding an exclusion means updating the spec and QualityGatePomTest.
    </description>

    <rule ref="rulesets/java/quickstart.xml">
        <!-- PERMANENT, not deferred. Originally excluded as DEFERRED pending
             the JCL->SLF4J migration; that migration is now complete and this
             exclusion is re-founded on a better, permanent reason instead of
             being deleted. Reactivating the rule after the migration flagged
             175 sites at activation, not the ~0 predicted, because the rule
             fires on ANY non-trivial log argument, not just string
             concatenation: a parameterized log.debug call fed a plain local
             variable is clean, but the same call fed an accessor such as
             weblog.getHandle() is flagged, and the latter is what
             essentially all idiomatic parameterized SLF4J code looks like.
             (ProperLogger, migrated the same way, came back
             genuinely clean at 167 -> 0 and stays active; this exclusion is
             not that migration's failure, it is this rule's mismatch with
             parameterized logging.) Excluded here, once, rather than via 74
             class-level @SuppressWarnings, for four reasons:
               1. This repo's own exclusion policy (the paragraph above, and
                  the design doc) reserves this file for whole families and
                  site-level suppressions for one-off violations with a stated
                  reason. 172 sites across 74 classes is one policy applied 74
                  times, not 74 individual judgements.
               2. A class-level suppression is BROADER than this exclusion,
                  for those classes: it silences the rule for all current AND
                  FUTURE code in them, including a genuinely expensive log
                  argument someone adds later. It is not the more conservative
                  option; it only looks like one.
               3. It satisfies the exclusion principle above exactly: with
                  parameterized SLF4J the rule cannot distinguish a cheap
                  accessor from expensive work, so violating it is
                  systematically not a defect in this architecture, and it
                  fires on idiomatic, correct code. The guard it asks for is
                  the ceremony this migration existed to delete.
               4. Governance: one exclusion in one file, closed by
                  QualityGatePomTest, reviewed once, versus 74 annotations
                  nobody will ever audit as a set. -->
        <exclude name="GuardLogStatement"/>
        <!-- Style opinion with no defect class behind it: an empty constructor
             is not improved by a comment saying it is empty. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <!-- while ((line = reader.readLine()) != null) is correct, idiomatic
             Java and the clearest way to write that loop. -->
        <exclude name="AssignmentInOperand"/>
        <!-- Style opinion, same reasoning as UncommentedEmptyConstructor. -->
        <exclude name="UncommentedEmptyMethodBody"/>
        <!-- WRONG for this architecture, not merely noisy: JPA entities are
             REQUIRED to declare a no-arg constructor, and this codebase is
             built on EclipseLink. -->
        <exclude name="UnnecessaryConstructor"/>
        <!-- Directly contradicts SpotBugs AT_STALE_THREAD_WRITE_OF_PRIMITIVE,
             which fires five times here and wants MORE volatile, not less.
             Two gates cannot disagree; SpotBugs is right on this one. -->
        <exclude name="AvoidUsingVolatile"/>
    </rule>

    <!-- Currently zero violations. Included precisely because holding zero
         forever is free, and a future one is worth failing a build over. -->
    <rule ref="category/java/security.xml"/>

    <!-- Rules chosen 2026-10 from PMD categories outside quickstart, each one a
         defect class and each held at zero. Chosen individually, never as a
         category: the rest of those categories is opinion or noise here. -->

    <!-- Locale-dependent formatting and a classloader that breaks in a WAR;
         two loggers in one class split its output. -->
    <rule ref="category/java/errorprone.xml/SimpleDateFormatNeedsLocale"/>
    <rule ref="category/java/errorprone.xml/UseProperClassLoader"/>
    <rule ref="category/java/errorprone.xml/MoreThanOneLogger"/>

    <!-- Dead stores (sometimes a value that was meant to be used), leaked
         resources, console output in server code, a default that swallows
         new enum constants, and suppressions that suppress nothing. -->
    <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>
    <rule ref="category/java/bestpractices.xml/UseTryWithResources"/>
    <rule ref="category/java/bestpractices.xml/SystemPrintln"/>
    <rule ref="category/java/bestpractices.xml/ExhaustiveSwitchHasDefault"/>
    <rule ref="category/java/bestpractices.xml/UnnecessaryVarargsArrayCreation"/>
    <rule ref="category/java/bestpractices.xml/UnnecessaryWarningSuppression"/>
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>
    <rule ref="category/java/bestpractices.xml/AvoidReassigningLoopVariables"/>

    <!-- Needless string building. -->
    <rule ref="category/java/performance.xml/AddEmptyString"/>
    <rule ref="category/java/performance.xml/UseStringBufferForStringAppends"/>
    <rule ref="category/java/performance.xml/InefficientStringBuffering"/>

    <!-- Redundant or misleading syntax that hides what the code does. -->
    <rule ref="category/java/codestyle.xml/ModifierOrder"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryCast"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryBoxing"/>
    <rule ref="category/java/codestyle.xml/UseDiamondOperator"/>

    <!-- Nested ifs, shared mutable statics, and NullPointerException thrown by hand. -->
    <rule ref="category/java/design.xml/CollapsibleIfStatements"/>
    <rule ref="category/java/design.xml/MutableStaticState"/>
    <rule ref="category/java/design.xml/AvoidThrowingNullPointerException"/>
</ruleset>
