<?xml version="1.0"?>
<ruleset name="Pressroom"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Pressroom's PMD gate: PMD's own quickstart set plus the security category,
        minus six rules, plus 45 named rules chosen from the other categories (the
        21 defect-finding rules of 2026-10, the 14 hygiene rules of 2026-11, the
        defect rules added after them and two complexity rules; see the groups
        below). Zero tolerance: see
        docs/superpowers/specs/2026-08-18-static-analysis-quality-gates-design.md.

        A rule is excluded only when violating it is SYSTEMATICALLY not a defect
        in this architecture, never merely because there are a lot of them.
        Adding an exclusion means updating the spec and QualityGatePomTest.
    </description>

    <rule ref="rulesets/java/quickstart.xml">
        <!-- PERMANENT, not deferred. Originally excluded as DEFERRED pending
             the JCL->SLF4J migration; that migration is now complete and this
             exclusion is re-founded on a better, permanent reason instead of
             being deleted. Reactivating the rule after the migration flagged
             175 sites at activation, not the ~0 predicted, because the rule
             fires on ANY non-trivial log argument, not just string
             concatenation: a parameterized log.debug call fed a plain local
             variable is clean, but the same call fed an accessor such as
             weblog.getHandle() is flagged, and the latter is what
             essentially all idiomatic parameterized SLF4J code looks like.
             (ProperLogger, migrated the same way, came back
             genuinely clean at 167 -> 0 and stays active; this exclusion is
             not that migration's failure, it is this rule's mismatch with
             parameterized logging.) Excluded here, once, rather than via 74
             class-level @SuppressWarnings, for four reasons:
               1. This repo's own exclusion policy (the paragraph above, and
                  the design doc) reserves this file for whole families and
                  site-level suppressions for one-off violations with a stated
                  reason. 172 sites across 74 classes is one policy applied 74
                  times, not 74 individual judgements.
               2. A class-level suppression is BROADER than this exclusion,
                  for those classes: it silences the rule for all current AND
                  FUTURE code in them, including a genuinely expensive log
                  argument someone adds later. It is not the more conservative
                  option; it only looks like one.
               3. It satisfies the exclusion principle above exactly: with
                  parameterized SLF4J the rule cannot distinguish a cheap
                  accessor from expensive work, so violating it is
                  systematically not a defect in this architecture, and it
                  fires on idiomatic, correct code. The guard it asks for is
                  the ceremony this migration existed to delete.
               4. Governance: one exclusion in one file, closed by
                  QualityGatePomTest, reviewed once, versus 74 annotations
                  nobody will ever audit as a set. -->
        <exclude name="GuardLogStatement"/>
        <!-- Style opinion with no defect class behind it: an empty constructor
             is not improved by a comment saying it is empty. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <!-- while ((line = reader.readLine()) != null) is correct, idiomatic
             Java and the clearest way to write that loop. -->
        <exclude name="AssignmentInOperand"/>
        <!-- Style opinion, same reasoning as UncommentedEmptyConstructor. -->
        <exclude name="UncommentedEmptyMethodBody"/>
        <!-- WRONG for this architecture, not merely noisy: JPA entities are
             REQUIRED to declare a no-arg constructor, and this codebase is
             built on EclipseLink. -->
        <exclude name="UnnecessaryConstructor"/>
        <!-- Directly contradicts SpotBugs AT_STALE_THREAD_WRITE_OF_PRIMITIVE,
             which fires five times here and wants MORE volatile, not less.
             Two gates cannot disagree; SpotBugs is right on this one. -->
        <exclude name="AvoidUsingVolatile"/>
    </rule>

    <!-- Currently zero violations. Included precisely because holding zero
         forever is free, and a future one is worth failing a build over. -->
    <rule ref="category/java/security.xml"/>

    <!-- Rules chosen 2026-10 from PMD categories outside quickstart, each one a
         defect class and each held at zero. Chosen individually, never as a
         category: the rest of those categories is opinion or noise here. -->

    <!-- Locale-dependent formatting and a classloader that breaks in a WAR;
         two loggers in one class split its output. -->
    <rule ref="category/java/errorprone.xml/SimpleDateFormatNeedsLocale"/>
    <rule ref="category/java/errorprone.xml/UseProperClassLoader"/>
    <rule ref="category/java/errorprone.xml/MoreThanOneLogger"/>

    <!-- Dead stores (sometimes a value that was meant to be used), leaked
         resources, console output in server code, a default that swallows
         new enum constants, and suppressions that suppress nothing. -->
    <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>
    <rule ref="category/java/bestpractices.xml/UseTryWithResources"/>
    <rule ref="category/java/bestpractices.xml/SystemPrintln"/>
    <rule ref="category/java/bestpractices.xml/ExhaustiveSwitchHasDefault"/>
    <rule ref="category/java/bestpractices.xml/UnnecessaryVarargsArrayCreation"/>
    <rule ref="category/java/bestpractices.xml/UnnecessaryWarningSuppression"/>
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>
    <rule ref="category/java/bestpractices.xml/AvoidReassigningLoopVariables"/>

    <!-- Needless string building. -->
    <rule ref="category/java/performance.xml/AddEmptyString"/>
    <rule ref="category/java/performance.xml/UseStringBufferForStringAppends"/>
    <rule ref="category/java/performance.xml/InefficientStringBuffering"/>

    <!-- Redundant or misleading syntax that hides what the code does. -->
    <rule ref="category/java/codestyle.xml/ModifierOrder"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryCast"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryBoxing"/>
    <rule ref="category/java/codestyle.xml/UseDiamondOperator"/>

    <!-- Nested ifs, shared mutable statics, and NullPointerException thrown by hand. -->
    <rule ref="category/java/design.xml/CollapsibleIfStatements"/>
    <rule ref="category/java/design.xml/MutableStaticState"/>
    <rule ref="category/java/design.xml/AvoidThrowingNullPointerException"/>

    <!-- Added 2026-11, maintenance pass. Mechanical hygiene held at zero so a
         new site fails the build instead of accumulating again. -->

    <!-- Needless allocation and work in string building: single characters
         appended as one-character strings, literals appended one call at a
         time, a builder re-named on every statement, a builder that must
         regrow past its declared size; and the legacy file streams, which
         carry a finalizer and so cost the collector work. -->
    <rule ref="category/java/performance.xml/AppendCharacterWithChar"/>
    <rule ref="category/java/performance.xml/ConsecutiveLiteralAppends"/>
    <rule ref="category/java/performance.xml/ConsecutiveAppendsShouldReuse"/>
    <rule ref="category/java/performance.xml/InsufficientStringBufferDeclaration"/>
    <rule ref="category/java/performance.xml/AvoidFileStream"/>

    <!-- Initialisers that restate the JVM default, C-style array declarators,
         a lowercase long suffix that reads as a one, and wildcard imports
         that hide where a name comes from. A decimal literal is grouped only
         from eight digits: the sRGB constants in BlurHash are published
         values, and 0.040_45 would be worse than 0.04045. -->
    <rule ref="category/java/performance.xml/RedundantFieldInitializer"/>
    <rule ref="category/java/codestyle.xml/CStyleArrayDeclaration"/>
    <rule ref="category/java/errorprone.xml/LongLiteralEndingWithLowercaseL"/>
    <rule ref="category/java/bestpractices.xml/OnDemandImport"/>
    <rule ref="category/java/codestyle.xml/UseUnderscoresInNumericLiterals">
        <properties>
            <property name="acceptableDecimalLength" value="7"/>
        </properties>
    </rule>

    <!-- Code that says what it means. Enums compare with ==, which is null-safe
         and checked by the compiler where equals() on an unrelated type is not;
         a field assigned only in the constructor is final; a local is declared
         where it is first needed, not above an early return; and a getX, isX,
         setX or canX name keeps the shape the name promises (a setter that
         returns a status, or a canX that returns a map, is renamed). -->
    <rule ref="category/java/bestpractices.xml/EnumComparison"/>
    <rule ref="category/java/design.xml/ImmutableField"/>
    <rule ref="category/java/codestyle.xml/PrematureDeclaration"/>
    <rule ref="category/java/codestyle.xml/LinguisticNaming"/>

    <!-- Added 2026-11, maintenance pass: rules that find defects, each site
         read and fixed by hand. -->

    <!-- A parameter keeps the value the caller passed. Two of the 42 sites
         were defects of the shape this hides: RegexUtil rewrote the text it
         was searching while still matching the original, and so edited the
         wrong address; GenericThrottle repaired a negative cache size but
         let zero through, which turned the throttle off. -->
    <rule ref="category/java/bestpractices.xml/AvoidReassigningParameters"/>

    <!-- Exceptions that say what went wrong. No raw RuntimeException (an
         unusable configuration is an IllegalStateException, an unreadable
         file an UncheckedIOException); no throws Exception, which made every
         caller catch everything (the two Spring Security filter-chain beans
         are suppressed at the site: HttpSecurity declares it); no unchecked
         exception in a throws clause; and no throw caught by its own method
         to jump to a 404, which is a branch written as an exception. -->
    <rule ref="category/java/design.xml/AvoidThrowingRawExceptionTypes"/>
    <rule ref="category/java/design.xml/SignatureDeclareThrowsException"/>
    <rule ref="category/java/design.xml/AvoidUncheckedExceptionsInSignatures"/>
    <rule ref="category/java/design.xml/ExceptionAsFlowControl"/>

    <!-- Internal arrays stay internal: a caller's array is copied on the way
         in and on the way out (CachedContent hands its bytes to the response
         with writeTo, not by returning them). A single-method interface says
         whether it is meant as a lambda: @FunctionalInterface, or a reasoned
         suppression for a role found with instanceof. -->
    <rule ref="category/java/bestpractices.xml/ArrayIsStoredDirectly"/>
    <rule ref="category/java/bestpractices.xml/MethodReturnsInternalArray"/>
    <rule ref="category/java/bestpractices.xml/ImplicitFunctionalInterface"/>
    <!-- Added 2026-11, maintenance pass: complexity held where a refactoring
         wave left it. Every method at cognitive complexity 20 or more (77 at
         15 or more, the largest 56, before) was refactored: guard clauses,
         one job per extracted method, small collaborators. The gate is the
         lowest level the tree honestly holds, so a new method that needs
         more is split before it lands, not after; and an if nested four deep
         is one level past what the rest of the tree reads at. Cyclomatic,
         NPath and GodClass are measured but not gated: they count what a
         reader does not struggle with (a flat switch, a linear sequence of
         setters). The numbers and the method: docs/dev/quality-gates.md,
         "Complexity". -->
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="20"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/AvoidDeeplyNestedIfStmts">
        <properties>
            <property name="problemDepth" value="4"/>
        </properties>
    </rule>
</ruleset>
