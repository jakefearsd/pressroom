<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pressroom's SpotBugs exclusion filter, re-counted on 2026-10-12 with
  find-sec-bugs 1.14.0 loaded. Five families: three of SpotBugs' own (557
  findings) and two of find-sec-bugs' (source markers 252,
  CRLF_INJECTION_LOGS 439). Everything outside them is at zero.

  IMPROPER_UNICODE is deliberately NOT here, though it fires on every case
  fold near an equals: a new fold must fail the build until someone decides,
  at that site, whether a person-typed name is being compared (the bug it
  caught in DisplayNames). Each of its 31 existing sites carries a reviewed
  @SuppressFBWarnings; QualityGatePomTest refuses the family. (The 2026-08 wave found 603 and fixed or suppressed the 134
  outside SpotBugs' own families at their sites: see
  docs/superpowers/specs/2026-08-18-static-analysis-quality-gates-design.md.)

  A new find-sec-bugs finding is triaged, never added here: trace it from
  source to sink, fix it if the input can reach the sink, otherwise suppress
  it at the site with the reason the input is not attacker-controlled or is
  already constrained, and where.

  Every Match block below needs a justification comment above it; QualityGatePomTest enforces it.
  One-off suppressions belong at the call site as @SuppressFBWarnings with a
  reason, not here: this file is for whole families only.
-->
<FindBugsFilter>
    <!-- JPA pojo accessors returning/storing Date and arrays (409 findings).
         Defensive copies fight EclipseLink's change tracking, and these pojos
         are not shared across threads. Copying every accessor would be a large
         behavioural change with no defect to show for it. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>

    <!-- Java-serialization complaints on entities that are never Java-serialized
         (42 findings), plus CT_CONSTRUCTOR_THROW (17), which is the Spring
         bean-init idiom this codebase is built on. -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED,SE_COMPARATOR_SHOULD_BE_SERIALIZABLE,CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Style opinions about exception declarations and constructor call graphs
         (89 findings), pervasive and load-bearing in framework-shaped code:
         template methods called from constructors are how the servlet and
         manager hierarchies are written. THROWS_METHOD_THROWS_CLAUSE_THROWABLE
         and MC_OVERRIDABLE_METHOD_CALL_IN_READ_OBJECT were listed here too and
         found nothing by 2026-10-12, so they are gate-checked again. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION,THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION,REC_CATCH_EXCEPTION,MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
    </Match>

    <!-- find-sec-bugs' source markers (252 findings). find-sec-bugs marks
         every place untrusted input enters; these are inventory, not
         findings — the sink detectors below are the gate. Listed by name,
         never by category or confidence, so no future sink detector is
         hidden with them. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT,SERVLET_PARAMETER,SERVLET_SERVER_NAME,SERVLET_QUERY_STRING,SERVLET_HEADER,SERVLET_HEADER_USER_AGENT,SERVLET_HEADER_REFERER"/>
    </Match>

    <!-- Log forging (CRLF_INJECTION_LOGS, 439 findings): fixed once, in
         configuration, not at every call site. log4j2.xml writes each message
         through %encode{%m}{CRLF}, so a CR or LF in a logged value comes out
         as the two characters \r or \n and one call writes one line
         (LogPatternTest pins it; QualityGatePomTest refuses this exclusion
         without it). Residual risk: a stack trace stays multi-line, and a
         Throwable's own message on its first line is not encoded. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
</FindBugsFilter>
