<?xml version="1.0" encoding="UTF-8"?>
<!--
  Roller's SpotBugs exclusion filter. Three families, 555 findings when
  re-counted on 2026-10-12; everything outside them is at zero. (The 2026-08
  wave found 603 and fixed or suppressed the 134 outside these families at
  their sites: see
  docs/superpowers/specs/2026-08-18-static-analysis-quality-gates-design.md.)

  Every Match block below needs a justification comment above it; QualityGatePomTest enforces it.
  One-off suppressions belong at the call site as @SuppressFBWarnings with a
  reason, not here: this file is for whole families only.
-->
<FindBugsFilter>
    <!-- JPA pojo accessors returning/storing Date and arrays (409 findings).
         Defensive copies fight EclipseLink's change tracking, and these pojos
         are not shared across threads. Copying every accessor would be a large
         behavioural change with no defect to show for it. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>

    <!-- Java-serialization complaints on entities that are never Java-serialized
         (42 findings), plus CT_CONSTRUCTOR_THROW (17), which is the Spring
         bean-init idiom this codebase is built on. -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED,SE_COMPARATOR_SHOULD_BE_SERIALIZABLE,CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Style opinions about exception declarations and constructor call graphs
         (87 findings), pervasive and load-bearing in framework-shaped code:
         template methods called from constructors are how the servlet and
         manager hierarchies are written. THROWS_METHOD_THROWS_CLAUSE_THROWABLE
         and MC_OVERRIDABLE_METHOD_CALL_IN_READ_OBJECT were listed here too and
         found nothing by 2026-10-12, so they are gate-checked again. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION,THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION,REC_CATCH_EXCEPTION,MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
    </Match>
</FindBugsFilter>
