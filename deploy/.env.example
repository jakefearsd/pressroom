# Environment for docker-compose.prod.yml. Copy to .env NEXT TO that file and
# fill in real values. Never commit the result -- it holds every secret in the
# stack.
#
# This file plus docker-compose.prod.yml is everything a production host needs.
# The same pair runs the stack locally; only the values below change, which is
# what makes "test exactly what you are about to deploy" true rather than
# aspirational. Local values are given beside each key that differs.

#-----------------------------------------------------------------------------
# Images
#-----------------------------------------------------------------------------
# Version tag for BOTH ghcr.io/jakefearsd/roller and
# ghcr.io/jakefearsd/roller-caddy. They are published together from one release
# job and must move together. Published only when a v*.*.* tag is pushed
# (.github/workflows/release.yml), so this is a release, never "whatever was on
# master".
#
# NOTE: GHCR packages are private on first publish. Until the package is made
# public (GitHub -> Packages -> Settings -> Change visibility) or you
# `docker login ghcr.io` here with a PAT carrying read:packages, an anonymous
# pull fails with "denied".
IMAGE_VERSION=0.1.15

# Extra JVM flags for the app container, e.g. -Xmx1g. Optional.
JAVA_OPTS=

#-----------------------------------------------------------------------------
# Public domain / TLS
#-----------------------------------------------------------------------------
# Your real domain. Caddy requests and auto-renews a Let's Encrypt certificate
# for it; you need only DNS pointed here and 80/443 reachable (80 carries the
# ACME challenge).
#
# LOCAL: use ":80". A bare port is not a certificate-able name, so automatic
# HTTPS never activates and Caddy serves plain HTTP.
#
# Deliberately NOT named ROLLER_DOMAIN: that prefix is reserved for app
# configuration (see below), and a stray ROLLER_DOMAIN would be overlaid onto
# the app's properties as a junk key named "domain".
SITE_DOMAIN=blog.example.com

# Host ports Caddy publishes. Unset, they are 80 and 443, which a public host
# needs (80 carries the ACME challenge). Move them when this host sits behind
# a tunnel connector or reverse proxy on ANOTHER machine (e.g. cloudflared)
# and 80/443 belong to something else: point the connector at
# http://<this host>:SITE_HTTP_PORT and leave SITE_DOMAIN at ":80". Only the
# host side moves; inside the container Caddy still listens on 80 and 443.
#SITE_HTTP_PORT=80
#SITE_HTTPS_PORT=443

# The proxy on another machine whose X-Forwarded-For and X-Forwarded-Proto
# Caddy keeps: its address, or several separated by spaces (CIDR ranges
# work too). Unset, Caddy trusts none and replaces both headers, which a
# public host needs; behind a connector it means every reader reaches the
# app as the connector's address, over plain HTTP. Name that one machine,
# never a whole private range. A malformed value stops Caddy, and the site.
#TRUSTED_PROXIES=192.168.1.50

# Where Roller sits on that domain. Unset (the default) it serves from the
# ROOT: a weblog is https://<domain>/<handle>/, and nothing in a canonical url,
# og:url, sitemap <loc> or feed id carries a path prefix that would later cost
# a redirect map to remove.
#
# Set this ONLY to share the hostname with another app, or to preserve the urls
# of an installation that already ran under /roller (the default before 0.1.4 --
# see docker_deployment.md, "The context path", for the Caddy redirect to move
# such a site to the root instead). It is a Spring Boot property rather than a
# ROLLER_* one, reached by relaxed binding, because the context path belongs to
# the servlet container and not to Roller's own configuration.
#SERVER_SERVLET_CONTEXT_PATH=/roller

# Per-weblog custom domains (virtual hosting): the DNS zone Caddy holds a
# WILDCARD certificate for, e.g. "thelocalwiki.com" for a *.thelocalwiki.com
# cert covering every subdomain under it with no per-blog deploy step. A
# wildcard can only be proven via the ACME DNS-01 challenge -- unlike
# SITE_DOMAIN above, this is not automatic; it needs the Caddy image built
# with a DNS provider module (see deploy/caddy/Dockerfile) and the token
# below. Leave both unset and this feature is simply inert -- SITE_DOMAIN
# keeps working exactly as before. Full procedure (this variable, the
# roller.properties `vhost.cert.zones` warning-only allowlist on the app
# side, the DNS record, then setting the domain on Weblog Settings):
# docker_deployment.md, "Custom domains (virtual hosting)".
#
# IMPORTANT: the moment ANY weblog has a custom domain, ROLLER_SITE_ABSOLUTEURL
# (below, under "Roller application configuration") becomes required too --
# see docker_deployment.md's step 0 for why leaving it unset misattributes
# every domain-less weblog's canonical urls to whichever host happens to hit
# the server first after boot.
#VHOST_ZONE=thelocalwiki.com

# API token for the DNS-01 challenge against VHOST_ZONE, scoped to that DNS
# provider account. deploy/caddy/Dockerfile bakes in the Cloudflare provider
# module (github.com/caddy-dns/cloudflare), so this must be a Cloudflare API
# token (My Profile -> API Tokens -> Create Token) with Zone:DNS:Edit on
# VHOST_ZONE and nothing more -- it never needs to touch anything else in the
# account. Building against a different DNS provider means changing both this
# comment and the module `xcaddy build --with`s in the Dockerfile together.
#VHOST_DNS_API_TOKEN=changeme-cloudflare-api-token

#-----------------------------------------------------------------------------
# Roller application configuration
#-----------------------------------------------------------------------------
# Every ROLLER_* variable here is overlaid onto the app's built-in defaults at
# startup: strip the prefix, lowercase, turn _ into . -- so
# ROLLER_MAIL_HOSTNAME sets the property mail.hostname. This is the
# highest-precedence configuration layer, and it is the ONLY one the production
# image uses; there is no properties file to mount. Any key documented in
# app/src/main/resources/org/apache/roller/weblogger/config/roller.properties
# can be set this way.

# Schema handling. 'auto' checks the schema at startup; the provision service
# has already applied every pending migration by then.
ROLLER_INSTALLATION_TYPE=auto

# Database. The URL's host is the compose service name; username and password
# must match POSTGRES_USER/POSTGRES_PASSWORD below, and the trailing path
# segment (the database name, "rollerdb") must match POSTGRES_DB below too --
# none of these three are templated against each other. Change POSTGRES_DB
# alone and provision migrates a database under the new name while this URL
# still points at the old, unmigrated one.
ROLLER_DATABASE_CONFIGURATIONTYPE=jdbc
ROLLER_DATABASE_JDBC_DRIVERCLASS=org.postgresql.Driver
ROLLER_DATABASE_JDBC_CONNECTIONURL=jdbc:postgresql://postgres:5432/rollerdb
ROLLER_DATABASE_JDBC_USERNAME=roller
ROLLER_DATABASE_JDBC_PASSWORD=changeme-generate-a-real-secret

# Storage paths. These match the image's own layout and the volumes mounted by
# docker-compose.prod.yml; there is no reason to change them.
ROLLER_THEMES_DIR=/app/themes
ROLLER_MEDIAFILES_STORAGE_DIR=/data/mediafiles
ROLLER_SEARCH_INDEX_DIR=/data/search-index
ROLLER_UPLOADS_DIR=/data/uploads

# Per-weblog custom domains (virtual hosting): comma-separated apex names the
# proxy holds a wildcard certificate for (see VHOST_ZONE above -- the two must
# name the same zone). Advisory only: saving a weblog's custom domain outside
# these zones on Weblog Settings produces a warning, nothing more. Startup
# property, not a runtime one -- unlike most ROLLER_* settings here, changing
# it needs a restart. Blank (the default) warns about nothing.
#ROLLER_VHOST_CERT_ZONES=thelocalwiki.com

# The site's own absolute address, e.g. https://blog.example.com -- REQUIRED
# the moment any weblog has a custom domain (see VHOST_ZONE above and
# docker_deployment.md's "Custom domains (virtual hosting)" step 0). Left
# blank, the app falls back to whichever hostname happens to hit the server
# first after boot, which under virtual hosting can be a custom domain --
# misattributing every domain-less weblog's canonical url, og:url, feed id,
# sitemap, robots.txt and password-reset links to it. It is also a runtime
# property (Admin -> Global Config -> "Absolute URL to site"): a value saved
# on that page wins over this variable, and while that field is blank (its
# default) this variable is used, so it can be set without an admin ever
# visiting the page.
#ROLLER_SITE_ABSOLUTEURL=https://blog.example.com

# Mail: your SMTP relay. Used for password-reset and notification mail.
# Username and password are optional -- set them only if your relay needs auth.
# Reset mail ALSO needs the "Site Administrator's email address" (Admin -> Global Config, the
# runtime property site.adminemail): it is the From address of every mail.
# Worked example, Brevo (the From address must be a verified sender/domain):
#   ROLLER_MAIL_HOSTNAME=smtp-relay.brevo.com
#   ROLLER_MAIL_PORT=587
#   ROLLER_MAIL_USERNAME=<Brevo SMTP login>
#   ROLLER_MAIL_PASSWORD=<Brevo SMTP key>
# mail.security defaults to starttls. docker_deployment.md, "Mail and account
# recovery".
ROLLER_MAIL_CONFIGURATIONTYPE=properties
ROLLER_MAIL_HOSTNAME=smtp.example.com
ROLLER_MAIL_PORT=587
#ROLLER_MAIL_USERNAME=
#ROLLER_MAIL_PASSWORD=

# Newsletter: where /newsletter/subscribe forwards to. The APP serves that
# endpoint (throttle + roller_event recording) and calls listmonk over the
# compose network -- Caddy has no route for it and must never be given one.
# Blank leaves the endpoint returning 503.
ROLLER_NEWSLETTER_LISTMONK_BASEURL=http://listmonk:9000

# Higher-privilege credentials for the entry editor's "Send as newsletter"
# button (a listmonk API user, Admin -> Users -> + New, Type: API -- see
# docker_deployment.md's Newsletter section for how to create one). Separate
# from LISTMONK_BASEURL above: leaving either of these blank disables only
# the Send-as-newsletter button, the public subscribe form keeps working
# regardless.
#ROLLER_NEWSLETTER_LISTMONK_APIUSER=
#ROLLER_NEWSLETTER_LISTMONK_APITOKEN=

#-----------------------------------------------------------------------------
# Postgres credentials
#-----------------------------------------------------------------------------
# Shared by postgres, provision, and backup. Keep POSTGRES_USER/PASSWORD in
# sync with ROLLER_DATABASE_JDBC_USERNAME/PASSWORD above, and POSTGRES_DB in
# sync with the database name in ROLLER_DATABASE_JDBC_CONNECTIONURL above --
# none of these are templated against each other, and changing POSTGRES_DB
# alone makes provision migrate one database while the app connects to
# another.
#
# Generate the password URL-safe:
#     openssl rand -base64 33 | tr '+/' '-_'
# (44 characters, no padding). docker-compose.prod.yml splices it into
# Umami's DATABASE_URL (postgresql://user:PASSWORD@postgres/...), so a "/"
# from plain base64 breaks Umami. Images up to 0.1.10 also refuse an
# even-length all-hex password (openssl rand -hex N) with EclipseLink-7360;
# see docker_deployment.md, Troubleshooting.
POSTGRES_DB=rollerdb
POSTGRES_USER=roller
POSTGRES_PASSWORD=changeme-generate-a-real-secret

#-----------------------------------------------------------------------------
# Nightly backup service
#-----------------------------------------------------------------------------
# Hour (UTC, 0-23) for pg_dump + volume snapshots. A bare number is clearest,
# though zero-padded is parsed correctly too.
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

#-----------------------------------------------------------------------------
# Analytics (Umami)
#-----------------------------------------------------------------------------
# Self-hosted and cookie-free, so no consent banner is required. The tracker
# and its collect endpoint are served from the BLOG's own origin at
# /analytics/* -- every bundled theme sends script-src 'self' and connect-src
# 'self', so a tracker on any other hostname is blocked and records nothing.
#
# Signing key for Umami's session tokens. Changing it logs everyone out.
#     openssl rand -hex 32
UMAMI_APP_SECRET=changeme-openssl-rand-hex-32

# Hostname for the Umami DASHBOARD (its UI assumes a domain root, so it cannot
# live under the blog's /analytics path). Unset, it defaults to
# analytics.invalid -- a name that cannot resolve, so the console is
# unreachable rather than accidentally published on your blog's domain.
#
# LOCAL: ":8081", reachable at http://localhost:8081
#UMAMI_DOMAIN=analytics.example.com

# Host port for that LOCAL console, always bound to 127.0.0.1 only. Move it if
# something on this host already listens on 8081 (on any address): caddy
# cannot start otherwise, and caddy is the blog's only way in. Inert when
# UMAMI_DOMAIN is a real hostname, but the port is still claimed.
#UMAMI_CONSOLE_PORT=8081

UMAMI_DB=umami

# Filename Umami serves its tracker under. Renaming it from script.js is the
# cheapest way to stop content blockers matching on the path.
UMAMI_SCRIPT_NAME=script.js

# How long (seconds) the analytics-views one-shot waits for Umami's own
# website_event table to appear before giving up on installing the Grafana
# traffic view. The default of 180s comfortably covers a normal first boot
# (Umami's own Prisma migrations); raise it only on very slow storage. A
# timeout here costs nothing but the Grafana traffic view -- the blog, Umami
# and Listmonk are unaffected, and re-running
# `docker compose -f docker-compose.prod.yml up -d analytics-views` once
# Umami has finished booting installs the view with no other side effects.
#ANALYTICS_VIEWS_WAIT_SECONDS=180

#-----------------------------------------------------------------------------
# Newsletter (Listmonk)
#-----------------------------------------------------------------------------
# Listmonk owns the subscribers, the double opt-in flow and the unsubscribe
# links; Roller stores no subscriber data at all.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=changeme-generate-a-real-secret

# Hostname for the newsletter admin AND the opt-in/unsubscribe pages
# subscribers follow from email. Needs its own name: running listmonk under a
# sub-path is an open upstream feature request, not a supported configuration.
#
# LOCAL: ":8082", reachable at http://localhost:8082
#LISTMONK_DOMAIN=newsletter.example.com

# Host port for that LOCAL console; same rules as UMAMI_CONSOLE_PORT above.
# Moving it moves the "localhost:8082" in LISTMONK_ROOT_URL below too.
#LISTMONK_CONSOLE_PORT=8082

# Must match LISTMONK_DOMAIN, with scheme and no trailing slash. Listmonk
# builds confirmation and unsubscribe links from this, and those links are the
# only way a subscriber can confirm or leave.
#
# LOCAL: http://localhost:8082
#LISTMONK_ROOT_URL=https://newsletter.example.com

LISTMONK_DB=listmonk

# NOTE: listmonk needs its own SMTP credentials to send anything. Those are set
# in its admin console (Settings -> SMTP), not here.
