# Caddy config for the production stack (docker-compose.prod.yml).
#
# {$SITE_DOMAIN} is substituted from the SITE_DOMAIN environment variable (see
# deploy/.env.example). It is deliberately NOT named PRESSROOM_DOMAIN any more:
# that prefix is reserved for app configuration, which the app container takes
# wholesale from .env via WebloggerConfig's environment overlay, and a stray
# PRESSROOM_DOMAIN would land there as a junk property named "domain".
#
# Two ways to run this:
#
#   - A real domain (e.g. blog.example.com): Caddy automatically obtains and
#     renews a Let's Encrypt certificate for it and serves HTTPS on 443,
#     redirecting HTTP (80) to HTTPS. Nothing else to configure.
#   - ":80" (LAN/local testing, no public domain/DNS): a bare port with no
#     hostname is not a certificate-able name, so Caddy's automatic HTTPS
#     never activates for it -- it just serves plain HTTP on port 80.

# Which peers may tell Caddy who the reader is. Caddy replaces an untrusted
# peer's X-Forwarded-For with the peer's own address and its
# X-Forwarded-Proto with "http", so behind a proxy on another machine (a
# tunnel connector such as cloudflared) every reader would reach the app as
# that machine, over HTTP. {$TRUSTED_PROXIES} (deploy/.env.example) names
# that machine; unset, Caddy trusts no one, which a public host needs.
# Never private_ranges: an internet client carried by Docker's userland
# proxy arrives from the bridge gateway, a private address.
#
# Cloudflare appends the reader's address to any X-Forwarded-For the reader
# sent, so the leftmost entry is the reader's to write; strict reads right
# to left, skipping trusted hops. The app's RemoteIpValve reads the same way.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

{$SITE_DOMAIN} {
	# Analytics, served from the BLOG's own origin.
	#
	# This is not a convenience. Every bundled theme head ships
	# `script-src 'self'; connect-src 'self'` under `default-src 'none'`, so a
	# tracker fetched from another hostname is blocked outright and its beacon
	# never sends. Serving the script and the collect endpoint here makes both
	# same-origin, which is what lets analytics ship without touching a policy
	# that three rendering tests pin byte-for-byte.
	#
	# An ALLOWLIST, not a prefix: only the tracker script (TRACKER_SCRIPT_NAME,
	# from UMAMI_SCRIPT_NAME) and POST /api/send reach Umami, each with the
	# /analytics prefix stripped so Umami sees the paths it serves at its own
	# root. Everything else under /analytics/ -- the login page, the whole
	# API -- answers 404 from Caddy and never reaches Umami. Umami's dashboard
	# and API are internal: the :8081 site below. ProductionComposeTest pins
	# these lines, and that this block and the custom-domain block match.
	#
	# {$ANALYTICS_UPSTREAM} is where Umami listens: umami:3000 in this compose
	# project by default, a LAN address (http://host:port) once it runs with
	# the back-office services (SA-15). Not their public hostname: through
	# the edge, Umami would count the edge's address instead of the reader's.
	@tracker path /analytics/{$UMAMI_SCRIPT_NAME:script.js}
	handle @tracker {
		uri strip_prefix /analytics
		reverse_proxy {$ANALYTICS_UPSTREAM}
	}
	@send {
		path /analytics/api/send
		method POST
	}
	handle @send {
		uri strip_prefix /analytics
		reverse_proxy {$ANALYTICS_UPSTREAM}
	}
	# Session replay and heatmaps are off; to switch them on, uncomment these and enable recording per website (docs/dev/umami-api.md).
	# @replay path /analytics/recorder.js /analytics/api/record /analytics/api/websites/*/recorder
	# handle @replay {
	# 	uri strip_prefix /analytics
	# 	reverse_proxy {$ANALYTICS_UPSTREAM}
	# }
	handle /analytics/* {
		respond 404
	}

	# /newsletter/subscribe is served by the app itself (throttle + events); do not re-add a rewrite here.

	handle {
		reverse_proxy app:8080 {
			# Caddy rewrites X-Forwarded-For/-Proto but passes an RFC 7239
			# Forwarded header through as the visitor wrote it; the app reads
			# only the X-Forwarded-* pair (Tomcat's RemoteIpValve), and this
			# keeps a visitor's own "for=" or "host=" from ever counting.
			header_up -Forwarded
		}
	}
}

# Per-weblog custom domains (virtual hosting): a weblog with a custom domain
# set on Weblog Settings is served here, one wildcard cert covering every
# subdomain under {$VHOST_ZONE} rather than a per-blog TLS/deploy step.
#
# {$VHOST_ZONE} and {$VHOST_DNS_API_TOKEN} come from deploy/.env.example. A
# wildcard name can only ever be proven via the ACME DNS-01 challenge (HTTP-01
# cannot issue for a "*" name at all), which is why this Caddyfile needs a
# Caddy binary built with a DNS provider module baked in -- see
# deploy/caddy/Dockerfile and docker_deployment.md's "Custom domains" section
# for the full procedure (vhost.cert.zones on the app, VHOST_ZONE here, a
# wildcard DNS record, then the domain on Weblog Settings). Left unset in
# .env, docker-compose.prod.yml substitutes a placeholder zone/token pair so
# this block still parses and Caddy still starts -- see the `caddy:` service
# environment there for why an empty token cannot be tolerated here the way
# an empty LISTMONK_DOMAIN can be below. The placeholder zone
# resolves nowhere and its wildcard certificate request simply fails forever
# in the background, the same harmless way theirs do; a deployment that
# doesn't use custom domains otherwise pays nothing for this block.
#
# The app resolves which weblog to serve purely from the Host header
# (VirtualHostRegistry), the same way it does for {$SITE_DOMAIN} above -- this
# block proxies to the identical upstream and carries no weblog-specific
# routing of its own.
#
# It also needs the SAME /analytics allowlist {$SITE_DOMAIN} has, and for
# the identical reason (see the comment on that block above): the tracking
# code emits a root-relative /analytics/script.js and
# posts its beacon to /analytics/api/send regardless of which hostname served
# the page, so without this here too, every custom-domain weblog's analytics
# silently 404 at the app (same-origin, so no CSP error; same-server, so no
# proxy error either) -- exactly the weblogs this feature exists to
# instrument. Umami keys collection on data-website-id, not on origin, so
# many hostnames posting to one website id is fine.
*.{$VHOST_ZONE} {
	tls {
		dns cloudflare {$VHOST_DNS_API_TOKEN}
	}

	@tracker path /analytics/{$UMAMI_SCRIPT_NAME:script.js}
	handle @tracker {
		uri strip_prefix /analytics
		reverse_proxy {$ANALYTICS_UPSTREAM}
	}
	@send {
		path /analytics/api/send
		method POST
	}
	handle @send {
		uri strip_prefix /analytics
		reverse_proxy {$ANALYTICS_UPSTREAM}
	}
	# Session replay and heatmaps are off; to switch them on, uncomment these and enable recording per website (docs/dev/umami-api.md).
	# @replay path /analytics/recorder.js /analytics/api/record /analytics/api/websites/*/recorder
	# handle @replay {
	# 	uri strip_prefix /analytics
	# 	reverse_proxy {$ANALYTICS_UPSTREAM}
	# }
	handle /analytics/* {
		respond 404
	}

	handle {
		reverse_proxy app:8080 {
			# Caddy rewrites X-Forwarded-For/-Proto but passes an RFC 7239
			# Forwarded header through as the visitor wrote it; the app reads
			# only the X-Forwarded-* pair (Tomcat's RemoteIpValve), and this
			# keeps a visitor's own "for=" or "host=" from ever counting.
			header_up -Forwarded
		}
	}
}

# The Umami dashboard and its API: never under the blog's name.
#
# A fixed port, not a hostname. docker-compose.prod.yml publishes it on
# UMAMI_CONSOLE_BIND (loopback unless .env names the host's LAN address),
# and the owner reaches it through a hostname of its own whose tunnel
# connector or proxy, on another machine, points at that LAN address. Pressroom
# itself calls Umami's API directly (analytics.umami.apiUrl), never through
# Caddy. Plain HTTP: a bare port is not a certificate-able
# name, and the tunnel or proxy terminates TLS.
:8081 {
	reverse_proxy {$ANALYTICS_UPSTREAM}
}

# The newsletter admin, and the opt-in / unsubscribe pages subscribers reach
# from their email. On its own hostname: listmonk assumes it owns a domain
# root. Unset, LISTMONK_DOMAIN
# defaults to a name that cannot resolve. {$NEWSLETTER_UPSTREAM} is where
# listmonk listens: listmonk:9000 in this compose project by default.
{$LISTMONK_DOMAIN} {
	reverse_proxy {$NEWSLETTER_UPSTREAM}
}
