<!-- to customize logging:
    - copy this file into the servers classpath and tweak it
    - set the log4j.configurationFile system property via roller-custom.properties or -D JVM arg -->

<!--useful for testing: monitorInterval="10" -->
<Configuration status="warn" name="Roller" >
    
    <!-- folder is automatically created if needed -->
    <properties>
        <!-- Resolved against an absolute base rather than the process working
             directory. A bare "logs" is whatever directory the container happened
             to be launched from: under Tomcat that is not writable, log4j2 fails to
             create the appender, and because the roller appender is referenced by an
             AsyncAppender the whole context fails to start - the application does
             not merely lose its log, it does not deploy.
             Order: explicit override, then Tomcat's base, then the working
             directory (which is what the embedded-Tomcat spring-boot:run dev
             server wants). -->
        <property name="logging.dir">${sys:roller.log.dir:-${sys:catalina.base:-.}/logs}</property>
        <!-- %encode{%m}{CRLF} writes a CR or LF inside a message as the two
             characters \r or \n, so one log call is one line and a
             reader-supplied value (a display name, a sign-in failure reason, a
             path) cannot forge a line that reads as a separate event. This is
             the fix for find-sec-bugs' CRLF_INJECTION_LOGS family, made once
             here instead of at ~440 call sites; LogPatternTest pins it, and
             every PatternLayout below must use this property.
             Trade-off: exception stack traces stay multi-line (the implicit
             %xEx PatternLayout appends is not encoded), because a one-line
             trace is unreadable. The residual risk is a Throwable whose
             message carries a reader's CR or LF: that message is written raw
             on the trace's first line. -->
        <property name="logging.pattern">%-5p %d{yyyy-MM-dd HH:mm:ss} [%t] %c{1} - %encode{%m}{CRLF}%n</property>
    </properties>

    <Appenders>

        <!-- Standard output: what `docker compose logs app` shows. Every logger
             below reaches it (LogRoutingTest), the named ones through
             asyncRoller and everything else through Root. -->
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="${logging.pattern}"/>
        </Console>
        
        <RollingFile name="roller"
                     fileName="${logging.dir}/roller.log" 
                     filePattern="${logging.dir}/roller-%d{yyyy-MM-dd-HHmmss}.log.gz"
                     ignoreExceptions="false">
            <PatternLayout pattern="${logging.pattern}"/>
            <Policies>
                <OnStartupTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="8 MB"/>
            </Policies>
            <!-- Rolled files are kept to the newest ten (about 80 MB at most):
                 the file rolls on every start and at 8 MB, and nothing else
                 ever deleted one, so a long-lived container filled up. -->
            <DefaultRolloverStrategy>
                <Delete basePath="${logging.dir}" maxDepth="1">
                    <IfFileName glob="roller-*.log.gz">
                        <IfAccumulatedFileCount exceeds="10"/>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- if you use this log4j2 config in the server classpath.
        <RollingFile name="server"
                     fileName="${logging.dir}/server.log" 
                     filePattern="${logging.dir}/server-%d{yyyy-MM-dd-HHmmss}.log.gz"
                     ignoreExceptions="false">
            <PatternLayout pattern="${logging.pattern}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="8 MB"/>
            </Policies>
            
        </RollingFile>
        -->
        <!-- Queue + thread, so a caller never waits on file or stdout IO.
             roller.log is inside the container (not on a volume), so on its
             own it is lost on every deploy and invisible to compose logs;
             the console copy is the one operators read. -->
        <Async name="asyncRoller">
            <AppenderRef ref="roller"/>
            <AppenderRef ref="console"/>
        </Async>
        
    </Appenders>

    <Loggers>
        
        <!-- roller.log and the console; everything not named here goes to the
             console alone, through Root -->
        <Logger name="com.wikantik.pressroom"   level="info"  additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <Logger name="org.apache.velocity"     level="info"  additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <Logger name="org.springframework"     level="info"  additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <Logger name="org.openid4java"         level="info"  additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <Logger name="org.eclipse.persistence" level="info"  additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>

        <!-- the MCP SDK logs the client's initialize text at INFO: caller-controlled -->
        <Logger name="io.modelcontextprotocol" level="warn" additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <Logger name="roller.sso" level="info" additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <!-- comment ids, statuses, usernames and refusal codes; never a body or an email address -->
        <Logger name="roller.comments" level="info" additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <!-- account, membership and API-token changes, each naming by=; never a token secret -->
        <Logger name="roller.admin" level="info" additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>
        <Logger name="org.webjars"             level="info"  additivity="false"> <AppenderRef ref="asyncRoller"/> </Logger>

        <!-- everything not named above -->
        <Root level="info">
        <!--<AppenderRef ref="server"/> -->
            <AppenderRef ref="console"/>
        </Root>
        
    </Loggers>

</Configuration>