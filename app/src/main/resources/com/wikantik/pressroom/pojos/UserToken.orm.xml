<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">
    <package>com.wikantik.pressroom.pojos</package>
    <entity metadata-complete="true" name="UserToken"
            class="com.wikantik.pressroom.pojos.UserToken" access="PROPERTY">
        <table name="roller_user_token"/>
        <named-query name="UserToken.getByDigest">
            <query>SELECT t FROM UserToken t WHERE t.tokenSha256 = ?1</query>
        </named-query>
        <named-query name="UserToken.removeByUser">
            <query>DELETE FROM UserToken t WHERE t.user = ?1</query>
        </named-query>
        <!-- The atomic half of consume(): a plain read-then-write (validate(),
             then a separate store()) lets two racing requests both read
             usedAt = null and both redeem the same token. This bulk UPDATE's
             WHERE clause is the single source of truth for "still usable":
             it can only ever affect 0 or 1 row, and the caller trusts the
             affected-row count, not a second read, to know which. -->
        <named-query name="UserToken.consumeIfUsable">
            <query>UPDATE UserToken t SET t.usedAt = ?1 WHERE t.tokenSha256 = ?2 AND t.usedAt IS NULL AND t.expires &gt; ?3</query>
        </named-query>
        <attributes>
            <id name="id">
                <column name="id"/>
            </id>
            <basic name="tokenSha256">
                <column name="token_sha256" insertable="true" updatable="true" unique="true" nullable="false"/>
            </basic>
            <basic name="purpose">
                <column name="purpose" insertable="true" updatable="true" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="created">
                <column name="created" insertable="true" updatable="true" nullable="false"/>
            </basic>
            <basic name="expires">
                <column name="expires" insertable="true" updatable="true" nullable="false"/>
            </basic>
            <basic name="usedAt">
                <column name="used_at" insertable="true" updatable="true" nullable="true"/>
            </basic>
            <many-to-one name="user" target-entity="com.wikantik.pressroom.pojos.User">
                <join-column name="userid" insertable="true" updatable="true" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>
</entity-mappings>
