<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">
    <package>com.wikantik.pressroom.pojos</package>
    <entity metadata-complete="true" name="MediaFileDirectory"
            class="com.wikantik.pressroom.pojos.MediaFileDirectory" access="PROPERTY">
        <table name="roller_mediafiledir"/>
        <named-query name="MediaFileDirectory.getByWeblog">
            <query>SELECT d FROM MediaFileDirectory d WHERE d.weblog = ?1</query>
        </named-query>
        <named-query name="MediaFileDirectory.getByWeblogAndName">
            <query>SELECT d FROM MediaFileDirectory d WHERE d.weblog = ?1 AND d.name = ?2</query>
        </named-query>
        <attributes>
            <id name="id">
                <column name="id"/>
            </id>
            <basic name="name">
                <column name="name" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <basic name="description">
                <column name="description" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="coverMediaFileId">
                <column name="cover_mediafile_id" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="private">
                <column name="is_private" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <many-to-one name="weblog" target-entity="com.wikantik.pressroom.pojos.Weblog">
                <join-column name="websiteid" insertable="true" updatable="true" nullable="false"/>
            </many-to-one>
            <one-to-many name="mediaFiles" mapped-by="directory" target-entity="com.wikantik.pressroom.pojos.MediaFile" fetch="LAZY">
                <order-by>name</order-by>
                <cascade>
                    <cascade-persist/>
                    <cascade-remove/>
                </cascade>
            </one-to-many>
            <transient name="empty"/>
        </attributes>
    </entity>
</entity-mappings>
