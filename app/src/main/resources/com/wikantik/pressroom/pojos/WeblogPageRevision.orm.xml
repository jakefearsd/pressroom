<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">
    <package>com.wikantik.pressroom.pojos</package>
    <entity metadata-complete="true" name="WeblogPageRevision"
            class="com.wikantik.pressroom.pojos.WeblogPageRevision" access="PROPERTY">
        <table name="pressroom_weblogpage_revision"/>
        <!-- Newest first; the id tie-break keeps two saves in one instant
             from ordering differently between reads (see
             WeblogEntryRevision.getByEntry). -->
        <named-query name="WeblogPageRevision.getByPage">
            <query>SELECT r FROM WeblogPageRevision r WHERE r.page = ?1 ORDER BY r.created DESC, r.id DESC</query>
        </named-query>
        <named-query name="WeblogPageRevision.removeByPage">
            <query>DELETE FROM WeblogPageRevision r WHERE r.page = ?1</query>
        </named-query>
        <!-- Every revision of every page of one weblog in a single statement. -->
        <named-query name="WeblogPageRevision.removeByWeblog">
            <query>DELETE FROM WeblogPageRevision r WHERE r.page IN
                   (SELECT p FROM WeblogPage p WHERE p.weblog = ?1)</query>
        </named-query>
        <attributes>
            <id name="id">
                <column name="id"/>
            </id>
            <basic name="created">
                <column name="created" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <basic name="creator">
                <column name="creator" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="title">
                <column name="title" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="content">
                <column name="content" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="note">
                <column name="note" insertable="true" updatable="true" unique="false" nullable="true"/>
            </basic>
            <basic name="kept">
                <column name="kept" insertable="true" updatable="true" unique="false" nullable="false"/>
            </basic>
            <many-to-one name="page" target-entity="com.wikantik.pressroom.pojos.WeblogPage">
                <join-column name="pageid" insertable="true" updatable="true" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>
</entity-mappings>
