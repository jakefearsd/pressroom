<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">

    <package>com.wikantik.pressroom.pojos</package>
    <entity metadata-complete="true" name="ObjectPermission"
            class="com.wikantik.pressroom.pojos.ObjectPermission" access="PROPERTY">
        <table name="pressroom_permission"/>
        <inheritance />
        <discriminator-column name="objecttype" />
        <attributes>
            <id name="id">
                <column name="id"/>
            </id>
            <basic name="objectId">
                <column name="objectid"/>
            </basic>
            <!-- <basic name="objectType">
                <column name="objecttype"/>
            </basic> -->
            <basic name="userName">
                <column name="username"/>
            </basic>
            <basic name="actions">
                <column name="actions"/>
            </basic>
            <basic name="dateCreated">
                <column name="datecreated"/>
                <temporal>DATE</temporal>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
