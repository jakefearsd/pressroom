<!--
  STOP!!!!  This is NOT a Pressroom configuration file!!
  Users of Pressroom should never need to edit this file.  The properties
  listed here should instead be changed on the Pressroom Admin Settings page.
  
  This file defines what properties are made available to get/set
  during the running of the Pressroom application (in contrast to the settings
  in pressroom-custom.properties which are read once before Pressroom startup).
  These runtime properties are stored in the database (pressroom_properties
  table) and the code *must* be able to make use of changed values during
  runtime.
  
  Also included in this file is meta-data which defines what class
  of property we are dealing with, its default value, and information
  on how to populate the display that allows for changing the value.
  
  NOTE: order does matter!!  the display is populated in a linear fashion
	starting from the first display-group and moving down.
-->

<runtime-configs> 

 <!--
   The global-properties represents the base set of pressroom runtime properties.
   In *most* cases you should be putting your properties here and they can
   then be changed from the admin configuration page at ...
        /admin/pressroomConfig.do
 -->
 <config-def name="global-properties">

   <!-- Site Settings Group -->
   <display-group name="siteSettings" key="configForm.siteSettings" >
   
      <property-def  name="site.name"  key="configForm.siteName">
         <type>string</type>
         <default-value>Pressroom Site</default-value>
      </property-def>
      <property-def  name="site.shortName"  key="configForm.shortName">
         <type>string</type>
         <default-value>Pressroom</default-value>
      </property-def>
      <property-def  name="site.description"  key="configForm.siteDescription">
         <type>text</type>
	 <default-value>A default install of the Pressroom Weblogger open source blog server</default-value>
      </property-def>      
      <property-def  name="site.verification.bing"  key="configForm.bingVerification">
         <type>string</type>
         <default-value></default-value>
      </property-def>
      <property-def  name="site.frontpage.weblog.handle"  key="configForm.frontpageWeblogHandle">
         <type>string</type>
         <default-value></default-value>
      </property-def>      
      <property-def  name="site.frontpage.page"  key="configForm.frontpagePage">
         <type>string</type>
         <default-value></default-value>
      </property-def>
      <property-def  name="site.privacy.page"  key="configForm.privacyPage">
         <type>string</type>
         <default-value></default-value>
      </property-def>
      <property-def  name="site.frontpage.weblog.aggregated"  key="configForm.frontpageWeblogAggregated">
         <type>boolean</type>
         <default-value>false</default-value>
      </property-def>
      <property-def  name="site.adminemail"  key="configForm.siteAdminEmail">
         <type>string</type>
         <default-value></default-value>
      </property-def>
      <property-def  name="site.absoluteurl"  key="configForm.absoluteUrl">
         <type>string</type>
         <default-value></default-value>
      </property-def>
   </display-group >

   <!-- Front Page Discovery Group. The refresh interval is stored in seconds
        and edited in minutes (Global Config posts discoveryRefreshMinutes);
        its key is therefore the minutes label. Ranges are enforced by
        DiscoverySettings.rangeError: window 1 to 365, share 0 to 100,
        refresh 60 to 86400 seconds. -->
   <display-group name="discoverySettings" key="configForm.discoverySettings" >
      <property-def  name="site.discovery.windowDays"  key="configForm.discoveryWindowDays">
         <type>integer</type>
         <default-value>30</default-value>
      </property-def>
      <property-def  name="site.discovery.sharePercent"  key="configForm.discoverySharePercent">
         <type>integer</type>
         <default-value>20</default-value>
      </property-def>
      <property-def  name="site.discovery.refreshSeconds"  key="configForm.discoveryRefreshMinutes">
         <type>integer</type>
         <default-value>3600</default-value>
      </property-def>
   </display-group >

   <!-- User Settings Group -->
   <display-group name="userSettings" key="configForm.userSettings" >
   
       <property-def name="site.allowUserWeblogCreation" key="configForm.allowUserWeblogCreation">
           <type>boolean</type>
           <default-value>true</default-value>
       </property-def>
       <!-- Both promoted from pressroom.properties. CreateWeblogController reads
            groupblogging.enabled per request; UserWrapper reads
            user.hideUserNames per render. Defaults match the startup file. -->
       <property-def name="groupblogging.enabled" key="configForm.groupBloggingEnabled">
           <type>boolean</type>
           <default-value>true</default-value>
       </property-def>
       <property-def name="user.hideUserNames" key="configForm.hideUserNames">
           <type>boolean</type>
           <default-value>true</default-value>
       </property-def>

   </display-group >

   <!-- Weblog Rendering Settings Group -->
   <display-group name="weblogSettings" key="configForm.weblogSettings" >
       
      <property-def  name="site.pages.maxEntries"  key="configForm.pageMaxEntries">
         <type>integer</type>
         <default-value>30</default-value>
      </property-def>
      <property-def  name="site.newsfeeds.defaultEntries"  key="configForm.newsfeedMaxEntries">
         <type>integer</type>
         <default-value>30</default-value>
      </property-def>
      <!-- Promoted from pressroom.properties. Only affects anchors generated
           after the change; anchors already stored on entries keep whichever
           separator was in force when they were created. -->
      <property-def  name="weblogentry.title.useUnderscoreSeparator"  key="configForm.underscoreSeparator">
         <type>boolean</type>
         <default-value>false</default-value>
      </property-def>

   </display-group>

   <!-- Revisions and trash: how much history is kept, and for how long. Saving
        a limit here removes nothing; the daily sweep applies it. -->
   <display-group name="revisionSettings" key="configForm.revisionSettings" >
      <!-- How many revisions to keep per entry. -1 keeps everything, which is
           the shipped behaviour: nothing is pruned unless an installation asks
           for it. 0 records no revisions at all. -->
      <property-def  name="entry.revisions.retention"  key="configForm.entryRevisionsRetention">
         <type>integer</type>
         <default-value>-1</default-value>
      </property-def>
      <!-- How many revisions each page keeps, newest first. -1 keeps all,
           0 records none. Bounded as shipped, unlike the entries', because
           page revisions are new and have no history to protect. -->
      <property-def  name="page.revisions.retention"  key="configForm.pageRevisionsRetention">
         <type>integer</type>
         <default-value>50</default-value>
      </property-def>
      <!-- Repeated saves by one person inside this many minutes share one
           revision, for posts and pages alike: the main brake on growth from
           repeated saving. 0 turns it off. A save with a note, a save by
           someone else and a revision restore always leave their own. -->
      <property-def  name="revisions.coalesce.minutes"  key="configForm.revisionsCoalesceMinutes">
         <type>integer</type>
         <default-value>10</default-value>
      </property-def>
      <!-- The daily sweep removes revisions older than this many days, but
           never an item's newest five nor a kept one. -1 is off. -->
      <property-def  name="revisions.maxAgeDays"  key="configForm.revisionsMaxAgeDays">
         <type>integer</type>
         <default-value>-1</default-value>
      </property-def>
      <!-- The most revisions the site keeps, posts and pages together. Over
           it, the sweep removes the oldest, under the same two protections.
           -1 is off. -->
      <property-def  name="revisions.total.max"  key="configForm.revisionsTotalMax">
         <type>integer</type>
         <default-value>-1</default-value>
      </property-def>
      <!-- How many days a trashed entry survives before TrashPurgeTask hard-
           deletes it. -1 keeps trash forever. 0 purges it on the very next
           sweep. Read fresh on every sweep; see TrashPurgeTask. -->
      <property-def  name="entry.trash.retention.days"  key="configForm.entryTrashRetentionDays">
         <type>integer</type>
         <default-value>30</default-value>
      </property-def>
      <!-- How many days a trashed page survives before TrashPurgeTask
           deletes it for good. -1 keeps it until deleted by hand. 0 purges
           it on the very next sweep. Read fresh on every sweep. Shorter than
           the entries' because a missing page is noticed sooner. -->
      <property-def  name="page.trash.retention.days"  key="configForm.pageTrashRetentionDays">
         <type>integer</type>
         <default-value>7</default-value>
      </property-def>
   </display-group >



   <!-- File Upload Settings Group -->
   <display-group name="uploadSettings" key="configForm.fileUploadSettings" >
   
      <property-def  name="uploads.enabled"  key="configForm.enableFileUploads">
         <type>boolean</type>
         <default-value>false</default-value>
      </property-def>
      <property-def  name="uploads.types.allowed"  key="configForm.allowedExtensions">
         <type>string</type>
         <default-value></default-value>
      </property-def>
      <property-def  name="uploads.types.forbid"  key="configForm.forbiddenExtensions">
         <type>string</type>
         <default-value>exe</default-value>
      </property-def>
      <property-def  name="uploads.file.maxsize"  key="configForm.maxFileSize">
         <type>float</type>
         <default-value>2.00</default-value>
      </property-def>
      <property-def  name="uploads.dir.maxsize"  key="configForm.maxDirSize">
         <type>float</type>
         <default-value>20.00</default-value>
      </property-def>
      <property-def  name="uploads.exif.stripGps"  key="configForm.stripGpsData">
         <type>boolean</type>
         <default-value>true</default-value>
      </property-def>

   </display-group >
   
   
    <!-- Theme Settings Group -->
   <display-group name="themeSettings" key="configForm.themeSettings">
   
      <property-def  name="users.themes.path"  key="configForm.newUserThemes">
         <type>string</type>
         <default-value>/themes</default-value>
      </property-def>
      <property-def  name="themes.customtheme.allowed"  key="configForm.allowCustomTheme">
         <type>boolean</type>
         <default-value>false</default-value>
      </property-def>

   </display-group>

   <!-- Automation API Settings Group -->
   <display-group name="apiSettings" key="configForm.apiSettings">

      <!-- Sizing (api.throttle.threshold, api.throttle.interval,
           api.throttle.maxentries) stays startup scoped in pressroom.properties:
           it dimensions a fixed cache that cannot be resized under live
           callers. Only the switch below is promoted to runtime. -->
      <property-def  name="api.throttle.enabled"  key="configForm.apiThrottleEnabled">
         <type>boolean</type>
         <default-value>true</default-value>
      </property-def>

   </display-group>

 </config-def>
 
</runtime-configs>
