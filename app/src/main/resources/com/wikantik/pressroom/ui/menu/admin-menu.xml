<!-- 
Defines the Pressroom Global Admin UI menu and roles allowed to use each menu. 
Each menu or menu item is governed by four attributes

See comments in editor-menu.xml for info about attributes.
-->
<menu-bar>
    
    <!--  if we already have checked globalPerms="admin" we should -->
    <!--  not need to recheck on each tab item as they are the same -->
    <menu name="tabbedmenu.admin" globalPerms="admin">
        
        <!-- globalPerms="admin" -->
        <menu-item action="globalConfig"
                   name="tabbedmenu.admin.config" />
        
        <!-- globalPerms="admin" -->
        <menu-item action="userAdmin"
                   name="tabbedmenu.admin.userAdmin"
                   subactions="createUser,modifyUser,agent" />

        <!-- globalPerms="admin" -->
        <menu-item action="businesses"
                   name="tabbedmenu.admin.businesses"
                   subactions="editBusiness" />

        <!-- globalPerms="admin"; every API token on the site (spec 2026-10-13) -->
        <menu-item action="apiTokens"
                   name="tabbedmenu.admin.apiTokens" />

        <!-- globalPerms="admin" -->
        <menu-item action="maintenance"
                   name="tabbedmenu.admin.maintenance" />

    </menu>

</menu-bar>
