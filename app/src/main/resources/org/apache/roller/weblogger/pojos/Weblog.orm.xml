<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">
	<package>org.apache.roller.weblogger.pojos</package>
	<entity metadata-complete="true" name="Weblog" class="org.apache.roller.weblogger.pojos.Weblog"
            access="PROPERTY">
		<table name="weblog"/>
		<named-query name="Weblog.getByHandle">
			<query>SELECT w FROM Weblog w WHERE w.handle = ?1</query>
		</named-query>
		<named-query name="Weblog.getByNewsletterListUuid">
			<!-- No unique constraint on newsletter_list_uuid: a shared family
			     newsletter across several weblogs is a legitimate setup, so
			     more than one row can match. ORDER BY handle makes "the
			     first result" deterministic rather than whatever order the
			     database happens to return. -->
			<query>SELECT w FROM Weblog w WHERE w.newsletterListUuid = ?1 ORDER BY w.handle</query>
		</named-query>
		<named-query name="Weblog.getByCustomDomain">
			<query>SELECT w FROM Weblog w WHERE w.customDomain = ?1</query>
		</named-query>
		<named-query name="Weblog.getByLetterOrderByHandle">
			<query>SELECT w FROM Weblog w WHERE UPPER(w.handle) like ?1 AND w.siteSpace = false ORDER BY w.handle</query>
		</named-query>
		<named-query name="Weblog.getCountAllDistinct">
			<!-- DISTINCT is not required here -->
            <query>SELECT COUNT(w) FROM Weblog w WHERE w.siteSpace = false</query>
		</named-query>
		<named-query name="Weblog.getCountByHandleLike">
			<query>SELECT COUNT(w) FROM Weblog w WHERE UPPER(w.handle) like ?1 AND w.siteSpace = false</query>
		</named-query>
		<attributes>
			<id name="id">
				<column name="id"/>
			</id>
			<basic name="handle">
				<column name="handle" insertable="true" updatable="true" unique="true"/>
			</basic>
			<basic name="about">
				<column name="about" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="iconPath">
				<column name="icon" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="name">
				<column name="name" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="tagline">
				<column name="tagline" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="copyright">
				<column name="copyright" insertable="true" updatable="true" unique="false"/>
			</basic>
            <basic name="analyticsSiteId">
                <column name="analytics_site_id" insertable="true" updatable="true" unique="false"/>
            </basic>
            <basic name="analyticsShareUrl">
                <column name="analytics_share_url" insertable="true" updatable="true" unique="false"/>
            </basic>
            <basic name="newsletterListUuid">
                <column name="newsletter_list_uuid" insertable="true" updatable="true" unique="false"/>
            </basic>
            <basic name="customDomain">
                <column name="custom_domain" insertable="true" updatable="true" unique="true"/>
            </basic>
			<basic name="emailAddress">
				<column name="emailaddress" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="editorTheme">
				<column name="editortheme" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="locale">
				<column name="locale" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="timeZone">
				<column name="timeZone" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="dateCreated">
				<column name="datecreated" insertable="true" updatable="true" unique="false"/>
				<temporal>TIMESTAMP</temporal>
			</basic>
            <basic name="entryDisplayCount">
				<column name="displaycnt" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="visible">
				<column name="visible" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="siteSpace">
				<column name="site_space" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="active">
				<column name="isactive" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="commentsEnabled">
				<column name="comments_enabled" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="commentNotify">
				<column name="comment_notify" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="creatorUserName">
				<column name="creator" insertable="true" updatable="true" unique="false"/>
			</basic>
			<basic name="lastModified">
				<column name="lastmodified" insertable="true" updatable="true" unique="false"/>
				<temporal>TIMESTAMP</temporal>
			</basic>
            <basic name="placeType">
                <column name="place_type" insertable="true" updatable="true"/>
            </basic>
            <basic name="placeLocality">
                <column name="place_locality" insertable="true" updatable="true"/>
            </basic>
            <basic name="placeRegion">
                <column name="place_region" insertable="true" updatable="true"/>
            </basic>
            <basic name="placeCountry">
                <column name="place_country" insertable="true" updatable="true"/>
            </basic>
            <basic name="placeLat">
                <column name="place_lat" insertable="true" updatable="true"/>
            </basic>
            <basic name="placeLng">
                <column name="place_lng" insertable="true" updatable="true"/>
            </basic>
            <basic name="bookingUrl">
                <column name="booking_url" insertable="true" updatable="true"/>
            </basic>
            <!-- Eager on purpose: the persistence unit runs without weaving,
                 so LAZY would be silently eager anyway; the row is tiny. -->
            <many-to-one name="business" target-entity="org.apache.roller.weblogger.pojos.Business">
                <join-column name="business_id" insertable="true" updatable="true" nullable="true"/>
            </many-to-one>
            <one-to-many name="weblogCategories" target-entity="org.apache.roller.weblogger.pojos.WeblogCategory" mapped-by="weblog">
                <order-by>position</order-by>
                <cascade>
                    <cascade-remove/>
                </cascade>
            </one-to-many>
            <one-to-many name="mediaFileDirectories" target-entity="org.apache.roller.weblogger.pojos.MediaFileDirectory" mapped-by="weblog">
                <cascade>
                    <cascade-persist/>
                    <cascade-remove/>
                </cascade>
            </one-to-many>
            <transient name="localeInstance"/>
            <transient name="timeZoneInstance" />
		</attributes>
	</entity>
</entity-mappings>
