<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence/orm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd">
    <package>org.apache.roller.weblogger.pojos</package>
    <entity metadata-complete="true" name="ApiToken"
            class="org.apache.roller.weblogger.pojos.ApiToken" access="PROPERTY">
        <table name="roller_api_token"/>
        <named-query name="ApiToken.getByDigest">
            <query>SELECT t FROM ApiToken t WHERE t.tokenSha256 = ?1</query>
        </named-query>
        <named-query name="ApiToken.getByUser">
            <query>SELECT t FROM ApiToken t WHERE t.user = ?1 ORDER BY t.created DESC</query>
        </named-query>
        <named-query name="ApiToken.removeByUser">
            <query>DELETE FROM ApiToken t WHERE t.user = ?1</query>
        </named-query>
        <named-query name="ApiToken.getLiveByUser">
            <query>SELECT t FROM ApiToken t WHERE t.user = ?1 AND t.revokedAt IS NULL
                   AND (t.expiresAt IS NULL OR t.expiresAt &gt; ?2) ORDER BY t.created DESC</query>
        </named-query>
        <named-query name="ApiToken.getAll">
            <query>SELECT t FROM ApiToken t ORDER BY t.created DESC</query>
        </named-query>
        <named-query name="ApiToken.getAllLive">
            <query>SELECT t FROM ApiToken t WHERE t.revokedAt IS NULL
                   AND (t.expiresAt IS NULL OR t.expiresAt &gt; ?1) ORDER BY t.created DESC</query>
        </named-query>
        <attributes>
            <id name="id">
                <column name="id"/>
            </id>
            <basic name="label">
                <column name="label" insertable="true" updatable="true" nullable="false"/>
            </basic>
            <basic name="tokenSha256">
                <column name="token_sha256" insertable="true" updatable="true" unique="true" nullable="false"/>
            </basic>
            <basic name="scopeWeblog">
                <column name="scope_weblog" insertable="true" updatable="true" nullable="true"/>
            </basic>
            <basic name="scopeRole">
                <column name="scope_role" insertable="true" updatable="true" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="created">
                <column name="created" insertable="true" updatable="true" nullable="false"/>
            </basic>
            <basic name="lastUsedAt">
                <column name="last_used_at" insertable="true" updatable="true" nullable="true"/>
            </basic>
            <basic name="expiresAt">
                <column name="expires_at" insertable="true" updatable="true" nullable="true"/>
            </basic>
            <basic name="revokedAt">
                <column name="revoked_at" insertable="true" updatable="true" nullable="true"/>
            </basic>
            <basic name="issuedBy">
                <column name="issued_by" insertable="true" updatable="true" nullable="true"/>
            </basic>
            <many-to-one name="user" target-entity="org.apache.roller.weblogger.pojos.User">
                <join-column name="userid" insertable="true" updatable="true" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>
</entity-mappings>
