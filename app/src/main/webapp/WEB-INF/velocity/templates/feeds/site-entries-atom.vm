*#<?xml version="1.0" encoding='utf-8'?>
#*
 No xml-stylesheet processing instruction: browsers are removing XSLT, so
 the feed is plain Atom for every client. The main site feed keeps the
 site's address as its <id> (subscribers already key on it); a category or
 tag feed's <id> is its own rel="self" address, as Atom requires. The
 generator names the version only: it used to publish the build machine's
 user name.
*#
#set($pager = $site.getWeblogEntriesPager(-1, $config.feedSize))
#if($model.tags)
#set($feedSelf = $url.feed.entries.atomByTags($model.tags, $model.excerpts))
#set($feedId = $feedSelf)
#elseif($model.categoryName)
#set($feedSelf = $url.feed.entries.atom($model.categoryName, $model.excerpts))
#set($feedId = $feedSelf)
#else
#set($feedSelf = $url.feed.entries.atom)
#set($feedId = $url.absoluteSite)
#end
<feed xmlns="http://www.w3.org/2005/Atom">
    <title type="html">$utils.escapeXML($config.siteName)</title>
    <subtitle type="html">$utils.escapeXML($config.siteDescription)</subtitle>
    <id>$utils.escapeXML($feedId)</id>
    <link rel="alternate" type="text/html" href="$url.absoluteSite" />
    <link rel="self" type="application/atom+xml" href="$utils.escapeXML($feedSelf)" />
    #if($config.feedHistoryEnabled)
        #showFeedHistory($pager)
    #end  
    <updated>$utils.formatIso8601Date($pager.lastUpdated)</updated>
    <generator version="$config.pressroomVersion">Pressroom</generator>
    #showEntriesAtom10($pager.items)
</feed>



