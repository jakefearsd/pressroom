*#<?xml version="1.0" encoding='utf-8'?>
#*
 No xml-stylesheet processing instruction: browsers are removing XSLT
 (Chrome bannered every feed that asked for atom.xsl as using a feature
 "being removed very soon"), so the feed is plain Atom for every client.
 The <id> is the feed's own rel="self" address: Atom requires each feed's
 id to be its own, and the category and tag feeds used to declare the main
 feed's.
*#
#set($pager = $model.weblogEntriesPager)
#if($model.tags)
#set($feedSelf = $url.feed.entries.atomByTags($model.tags, $model.excerpts))
#elseif($model.categoryName)
#set($feedSelf = $url.feed.entries.atom($model.categoryName, $model.excerpts))
#else
#set($feedSelf = $url.feed.entries.atom)
#end
<feed xmlns="http://www.w3.org/2005/Atom">
    <title type="html">$utils.escapeXML($model.weblog.name)</title>
    <subtitle type="html">$utils.escapeXML($model.weblog.tagline)</subtitle>
    <id>$feedSelf</id>
    <link rel="self" type="application/atom+xml" href="$feedSelf" />
    <link rel="alternate" type="text/html" href="$url.home" />
    #if($config.feedHistoryEnabled)
        #showFeedHistory($pager)
    #end
    <updated>$utils.formatIso8601Date($model.weblog.lastModified)</updated>
    <generator version="$config.rollerVersion">Roller</generator>
    #showEntriesAtom10($pager.items)
</feed>

