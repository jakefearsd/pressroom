<!doctype html>
<html lang="$model.weblog.getLanguageTag()">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    ## $model.weblog.name is pre-escaped by WeblogWrapper#getName
    ## (StringEscapeUtils.escapeHtml4) -- emit it bare, or it double-encodes
    ## ("&amp;" -> "&amp;amp;"), same as frontpage/weblog.vm's $blog.name.
    ## A meta title is the whole title: the editor's search preview shows it
    ## alone, so that is what an author who fills it in is writing.
    #if($utils.isNotEmpty($model.weblogEntry.pojo.metaTitle))
    <title>#showEntryTitle($model.weblogEntry)</title>
    #else
    <title>$utils.titleWithName($model.weblogEntry.title, $model.weblog.name)</title>
    #end
    <link href="$url.absoluteSite/favicon.svg" rel="icon" type="image/svg+xml" />
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    <link rel="stylesheet" href="$model.weblog.stylesheet">
    #showSeoHead()
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showEmbedAssets()
    #showAudienceAssets()
    #showMapAssets()
    #showContentAssets()
</head>
<!-- permalink -->
<body class="pf#if($model.weblog.wideLayout) pf-wide#end">
<a class="pf-skip" href="#main">Skip to content</a>
## The site's name, the way to its front page and its other blogs (weblog.vm).
#showSiteBar($model.weblog)

<header class="pf-header">
    <p class="pf-name"><a href="$url.home">$model.weblog.name</a></p>
    <nav class="pf-nav">
        #showWeblogCategoryLinksList()
        <ul class="rCategory">
        #showPageLinks($model.weblog)
        </ul>
    </nav>
</header>

<main class="pf-main pf-main-entry" id="main">
    #set($pager = $model.getWeblogEntriesPager())
    ## Set when the post is a reader-visible part of a published strand: the
    ## strand bar (in _day) and the part steps below replace Older/Newer.
    #set($strandNav = $pager.strandNav)
    #showWeblogEntriesPager($pager)

    ## Share row, Nearby and Keep reading (weblog.vm documents the macro).
    #showAfterEntry($model.weblogEntry)

    #showComments($model.weblog $model.weblogEntry)

    ## Journal's reading-view steps: each neighbour on its own line with its
    ## real title, where the showNextPrevEntriesControl macro cut it to 15-20
    ## characters. Older on the left, newer on the right. Titles are stored
    ## HTML-escaped (EntryBean.copyTo), so they are emitted bare.
    #if($strandNav)
    <nav class="pf-pager pf-steps" aria-label="More entries">
        #if($strandNav.previous)
        <a class="pf-step pf-step-back" href="$url.entry($strandNav.previous.anchor)" rel="prev">
            <span class="pf-step-label">$text.get("entryMeta.strandPrevious")</span>
            <span class="pf-step-title">$strandNav.previous.title</span>
        </a>
        #else
        <span class="pf-step pf-step-empty"></span>
        #end
        #if($strandNav.next)
        <a class="pf-step pf-step-fwd" href="$url.entry($strandNav.next.anchor)" rel="next">
            <span class="pf-step-label">$text.get("entryMeta.strandNext")</span>
            <span class="pf-step-title">$strandNav.next.title</span>
        </a>
        #else
        <a class="pf-step pf-step-fwd" href="$url.staticPage($strandNav.strand)">
            <span class="pf-step-label">$text.get("entryMeta.strandAllParts")</span>
            <span class="pf-step-title">$utils.escapeHTML($strandNav.strand.title)</span>
        </a>
        #end
    </nav>
    #else
    #set($older = $pager.prevEntry)
    #set($newer = $pager.nextEntry)
    #if($older || $newer)
    <nav class="pf-pager pf-steps" aria-label="More entries">
        #if($older)
        <a class="pf-step pf-step-back" href="$url.entry($older.anchor)" rel="prev">
            <span class="pf-step-label">$text.get("pager.older")</span>
            <span class="pf-step-title">$older.title</span>
        </a>
        #else
        <span class="pf-step pf-step-empty"></span>
        #end
        #if($newer)
        <a class="pf-step pf-step-fwd" href="$url.entry($newer.anchor)" rel="next">
            <span class="pf-step-label">$text.get("pager.newer")</span>
            <span class="pf-step-title">$newer.title</span>
        </a>
        #end
    </nav>
    #end
    #end
</main>

<footer class="pf-footer">
    <form class="pf-search" role="search" method="get" action="$url.search">
        <input type="search" name="q" maxlength="255" placeholder="Search" aria-label="$text.get("macro.weblog.searchbutton")">
    </form>
    #showBusinessCard($model.weblog "Book a session")
    #showColophon($model.weblog)
</footer>

</body>
</html>
