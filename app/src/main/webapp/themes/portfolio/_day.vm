## $model here is a PageModel
## $entry here is a WeblogEntryWrapper
##
## Portfolio theme day fragment. On entry-list pages it emits bare grid
## cards -- the enclosing template supplies the single .pf-grid flex
## container, so multiple days flow together into one justified grid
## (the #showWeblogEntriesPager macro parses this fragment once per day
## with no wrapper of its own). On the permalink page it emits the
## image-first entry layout: hero featured image, content, minimal meta.
<!-- _day -->
#if($model.permalink)
    #foreach($entry in $entries)
    <article class="pf-entry">
        #if($entry.featuredImage)
        <figure class="pf-hero">
        ## Alt text: #showResponsiveImage escapes its $alt argument, and
        ## $entry.title is ALREADY stored escaped -- passing it straight in
        ## made a screen reader announce "&amp;amp;". The image's own
        ## MediaFile.altText (raw, W4) is the right description when it has
        ## one; the title is only a fallback, unescaped first so the macro's
        ## single escape lands on the plain text.
            #set($heroAlt = $utils.unescapeHTML($entry.title))
            #if($utils.isNotEmpty($entry.featuredImage.altText))#set($heroAlt = $entry.featuredImage.altText)#end
            #showResponsiveImage($entry.featuredImage $heroAlt "100vw" "pf-hero-img")
        </figure>
        #end
        <div class="pf-entry-body">
            ## The reading view's own title is the page's h1; the weblog
            ## name in the header is a paragraph on this page.
            <h1 class="pf-entry-title">$entry.title</h1>
            <div class="pf-entry-content">$entry.displayContent</div>
            <p class="pf-entry-meta">
                <time datetime="$utils.formatIso8601Day($entry.pubTime)">$utils.formatDate($entry.pubTime, "MMMM d, yyyy")</time>
                &middot; <a href="$url.category($entry.category.name)">$utils.escapeHTML($entry.category.name)</a>
                #if($utils.isUserAuthorizedToAuthor($entry.website))
                &middot; <a href="$url.editEntry($entry.anchor)">$text.get("generic.edit")</a>
                #end
            </p>
            ## After the meta line, which is itself after the content here:
            ## the tag row closes the entry rather than interrupting it.
            #if(!$entry.tags.isEmpty())
            <p class="pf-entry-tags">#showEntryTags($entry)</p>
            #end
        </div>
    </article>
    #end
#else
    #foreach($entry in $entries)
        #if($entry.featuredImage)
            ## --ar (width / height) drives the justified packing: flex-grow
            ## and flex-basis in the stylesheet, same convention as .jgrid.
            #set($cardAspect = false)
            #if($entry.featuredImage.width > 0 && $entry.featuredImage.height > 0)
                #set($cardAspect = 1.0 * $entry.featuredImage.width / $entry.featuredImage.height)
            #end
    <figure class="pf-card"#if($cardAspect) style="--ar:$cardAspect"#end>
        <a class="pf-card-link" href="$url.entry($entry.anchor)">
            #set($cardAlt = $utils.unescapeHTML($entry.title))
            #if($utils.isNotEmpty($entry.featuredImage.altText))#set($cardAlt = $entry.featuredImage.altText)#end
            #showResponsiveImage($entry.featuredImage $cardAlt "(max-width: 640px) 100vw, 40vw" "pf-card-img")
            <h2 class="pf-card-title">$entry.title</h2>
        </a>
    </figure>
        #else
    <figure class="pf-card pf-card-text">
        <a class="pf-card-link" href="$url.entry($entry.anchor)">
            <h2 class="pf-card-title">$entry.title</h2>
            <time class="pf-card-date" datetime="$utils.formatIso8601Day($entry.pubTime)">$utils.formatDate($entry.pubTime, "MMMM d, yyyy")</time>
        </a>
    </figure>
        #end
    #end
#end
