<!doctype html>
<html lang="$model.weblog.getLanguageTag()">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; font-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    ## directory.vm #sets $fdPageTitle before including this header and
    ## weblog.vm does not, so the front door keeps the bare site name while
    ## the directory says which view it is. #includeTemplate is a #parse, and
    ## a #parse shares the caller's context -- that is what makes a plain #set
    ## in the including template visible here.
    #if($fdPageTitle)
    <title>$utils.escapeHTML($fdPageTitle) : $utils.escapeHTML($config.siteName)</title>
    #else
    <title>$utils.escapeHTML($config.siteName)</title>
    #end
    <link href="$url.absoluteSite/favicon.svg" rel="icon" type="image/svg+xml" />
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    #showSeoHead()
    <link rel="stylesheet" href="$model.weblog.stylesheet">
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showMapAssets()
    #showContentAssets()
    #showAudienceAssets()
</head>
<body class="fd">
<a class="fd-skip" href="#main">Skip to content</a>

<header class="fd-topbar">
    <a class="fd-topbar-brand" href="$url.absoluteSite">$utils.escapeHTML($config.siteName)</a>
    <nav class="fd-topbar-links">
        #if(!$utils.isUserAuthenticated())
        <a href="$url.login">Login</a>
        #else
        #if($utils.isUserAuthor())
        <a href="$url.absoluteSite/roller-ui/menu.rol">Main Menu</a>
        #end
        <a href="$url.logout">Logout</a>
        #end
    </nav>
</header>

<main class="fd-main" id="main">
  <div class="fd-hero">
      <h1 class="fd-site"><a href="$url.home">$utils.escapeHTML($config.siteName)</a></h1>
      #if($utils.isNotEmpty($config.siteDescription))
      <p class="fd-tag">$utils.escapeHTML($config.siteDescription)</p>
      #end
  </div>
  <nav class="fd-tabs">
      <a href="$url.home">Recent Entries</a>
      <a href="$url.page("directory")">Weblog Directory</a>
  </nav>
