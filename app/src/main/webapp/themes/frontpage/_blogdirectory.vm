## $site here is the SiteModel; $pageLength was set by directory.vm.
## Restyled A-Z weblog directory: the same fd-dir/fd-blog grid weblog.vm
## uses for its "Weblogs" preview, plus the letter index and paging that
## make this the FULL directory (weblog.vm only ever shows a handful of
## recently-created weblogs).
#if($model.getRequestParameter("letter"))
    #set($chosenLetter = $model.getRequestParameter("letter"))
#end

#set($weblogLetterMap = $site.getWeblogHandleLetterMap())
<p class="fd-letters">
#set($firstLetterDone = 0)
#foreach($letter in $weblogLetterMap.keySet())
    #if($firstLetterDone == 1) &middot; #end
    #set($firstLetterDone = 1)
    #set($letterCount = $weblogLetterMap.get($letter))
    #if($letterCount > 0)
       <a class="#if($letter == $chosenLetter)current#end" href="?letter=$letter" title="$letterCount weblog#if($letterCount != 1)s#end">$letter</a>
    #else
       <span>$letter</span>
    #end
#end
</p>

#if($chosenLetter)
   <h2 class="fd-label">Weblogs starting with $utils.escapeHTML($chosenLetter)</h2>
#else
   <h2 class="fd-label">All weblogs</h2>
#end

#set($weblogsPager = $site.getWeblogsByLetterPager($chosenLetter, -1, $pageLength))
<div class="fd-dir">
#foreach($loopblog in $weblogsPager.items)
    <a class="fd-blog" href="$utils.escapeHTML($loopblog.absoluteURL)">
        <p class="n">$loopblog.name</p>
        <p class="h"><span class="live" aria-hidden="true"></span>$utils.escapeHTML($loopblog.handle)</p>
    </a>
#end
</div>

## The same step pager as the front door's, in place of the
## "&lt; Previous | Next &gt;" strip. The directory runs in a fixed order
## rather than through time, so the steps say Previous and Next.
#if($weblogsPager.prevLink || $weblogsPager.nextLink)
<nav class="fd-pager fd-steps" aria-label="More weblogs">
    #if($weblogsPager.prevLink)
    <a class="fd-step fd-step-back" href="$weblogsPager.prevLink" rel="prev">
        <span class="fd-step-label">Previous</span>
        <span class="fd-step-title">Previous weblogs</span>
    </a>
    #else
    <span class="fd-step fd-step-empty"></span>
    #end
    #if($weblogsPager.nextLink)
    <a class="fd-step fd-step-fwd" href="$weblogsPager.nextLink" rel="next">
        <span class="fd-step-label">Next</span>
        <span class="fd-step-title">More weblogs</span>
    </a>
    #end
</nav>
#end
