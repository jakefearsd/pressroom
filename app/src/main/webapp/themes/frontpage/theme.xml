<weblogtheme>
    
    <id>frontpage</id>
    <name>Frontpage</name>
    <description>Theme for aggregated front-page of large multi-blog site.</description>
    <author>Dave Johnson</author>

    <!-- theme preview image -->
    <preview-image path="frontpage-preview.png" />

    <!-- stylesheet -->
    <stylesheet>
        <name>frontpage-custom.css</name>
        <description>Stylesheet for Frontpage theme</description>
        <link>frontpage-custom.css</link>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>frontpage-custom.css</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </stylesheet>

    <!-- templates -->
    <template action="weblog">
        <name>Weblog</name>
        <description>Weblog</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>weblog.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
    
    <template action="custom">
        <name>_blogdirectory</name>
        <description>_blogdirectory</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_blogdirectory.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_decorator</name>
        <description>_decorator</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_decorator.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
    
    <template action="custom">
        <name>_entry</name>
        <description>_entry</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_entry.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
    
    <template action="custom">
        <name>_footer</name>
        <description>_footer</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_footer.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
    
    <template action="custom">
        <name>_header</name>
        <description>_header</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_header.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
    
    <!-- the front-door weblog's static pages, in the fd chrome rather than
         the shared fallback (PageServlet looks a theme's _page up by name) -->
    <template action="custom">
        <name>_page</name>
        <description>_page</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>page.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>directory</name>
        <description>weblog directory</description>
        <link>directory</link>
        <navbar>false</navbar>
        <hidden>false</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>directory.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
    
    <!-- the discovery front page at the site root: the site space serves it
         to FrontDoor's forward alone (PageServlet looks it up by name), and
         hidden keeps a blog on this theme from serving it by name -->
    <template action="custom">
        <name>discovery</name>
        <description>discovery front page</description>
        <link>discovery</link>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>discovery.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <!-- resources: none. The two tan GIFs declared here were the last of the
         pre-restyle raster assets; no template referenced them and the files
         are deleted, so a declaration would only make ThemeManager try to
         copy something that is not there. -->

</weblogtheme>
