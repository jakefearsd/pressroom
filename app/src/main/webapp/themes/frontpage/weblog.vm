## The search branch is keyed on $model.searchResults (PageModel answers
## false, SearchResultsModel true). It used to test $model.results, which is
## an empty map on a search that found nothing -- and Velocity's #if treats
## an empty map as false, so that search got the front door back with no word
## about the query. The title is set before the header is included, since the
## header renders the document head; rawTerm is unescaped and _header escapes
## it once.
#if($model.searchResults)
    #set($fdPageTitle = "Search: $model.rawTerm")
#else
    #set($fdTab = "home")
#end
#includeTemplate($model.weblog "_header")

#set($maxResults = 25)
#set($since = 365)

#if(!$model.searchResults)
    ## 1) SITE-WIDE entries (the default)
    #set($pager = $site.getWeblogEntriesPager($since, $maxResults))

    ## 2) PLANET-entries
    ## set($pager = $planet.getAggregationPager($since, $maxResults))
    ## The below pager code should work against either:

    <h2 class="fd-label">Latest across the site</h2>
    <div class="fd-posts">
    ## Pinned entries belong at the top of the front page -- that's the
    ## FIRST page of the pager (prevLink null), not the LAST (nextLink null).
    ## Their ids are remembered so the pager's own items below skip them: a
    ## recent pinned entry is also one of the newest, and was listed twice.
    #set($pinnedIds = [])
    #if(!$pager.prevLink)
        #set($pinnedEntries = $site.getPinnedWeblogEntries(5))
        #set($fdPinned = true)
        #foreach($pinnedEntry in $pinnedEntries)
            #set($entry = $pinnedEntry)
            #set($pinnedAdded = $pinnedIds.add($pinnedEntry.id))
            #includeTemplate($model.weblog "_entry")
        #end
        #set($fdPinned = false)
    #end

    #set($fdListed = 0)
    #foreach($entry in $pager.items)
        #if(!$pinnedIds.contains($entry.id))
        #set($fdListed = $fdListed + 1)
        #includeTemplate($model.weblog "_entry")
        #end
    #end
    #if($fdListed == 0 && $pinnedIds.isEmpty())
        <p class="fd-list-empty">Nothing has been published across the site yet. New posts from every weblog will appear here.</p>
    #end
    </div>

    ## Journal's Newer/Older steps, in place of "&lt; Previous | Next &gt;". The
    ## site pager runs newest first, so getNextLink() is older posts and
    ## getPrevLink() newer ones; the older step comes first, on the left.
    #if($pager.prevLink || $pager.nextLink)
    <nav class="fd-pager fd-steps" aria-label="More entries">
        #if($pager.nextLink)
        <a class="fd-step fd-step-back" href="$pager.nextLink" rel="next">
            <span class="fd-step-label">$text.get("pager.older")</span>
            <span class="fd-step-title">Earlier posts</span>
        </a>
        #else
        <span class="fd-step fd-step-empty"></span>
        #end
        #if($pager.prevLink)
        <a class="fd-step fd-step-fwd" href="$pager.prevLink" rel="prev">
            <span class="fd-step-label">$text.get("pager.newer")</span>
            <span class="fd-step-title">More recent posts</span>
        </a>
        #end
    </nav>
    #end

#else
    ## We've got search results to display
    #set($pager = $model.getWeblogEntriesPager())

    <h2 class="fd-label">Search results</h2>
    <div class="fd-search-again">
        #showWeblogSearchAgainForm($model.weblog)
        #if($model.hits > 0)
            #showNextPrevSearchControl($pager)
        #end
    </div>
    ## The same two sentences as the article themes' searchresults.vm, the
    ## error first because a failed search also reports zero hits. The
    ## exception text is internal detail and never printed.
    #if($utils.isNotEmpty($model.errorMessage))
    <p class="fd-search-error">Search is temporarily unavailable. Please try again shortly.</p>
    #elseif($model.hits == 0)
    <p class="fd-search-empty">No posts matched that search. Try a different word, or a shorter phrase.</p>
    #end

    <div class="fd-posts">
    #set($map = $pager.getEntries())
    #foreach($day in $map.keySet())
        #set($entries = $map.get($day))
        #foreach($entry in $entries)
            #includeTemplate($model.weblog "_entry")
        #end
    #end
    </div>

#end

## Every visible weblog, newest first, not only those CREATED in the last
## $since days: on a small site that window emptied a year after launch and
## the grid vanished under its own heading. getNewWeblogs takes a day count
## and has no "no limit" value (-1 means "since tomorrow"), hence a century.
#set($allTime = 36500)
#set($newblogs = $site.getNewWeblogs($allTime, $maxResults))
#if(!$newblogs.isEmpty())
<h2 class="fd-label">Weblogs</h2>
<div class="fd-dir">
## $blog.name is a WeblogWrapper property -- WeblogWrapper#getName already
## runs it through StringEscapeUtils.escapeHtml4, so escaping it again here
## would double-encode ("&amp;" -> "&amp;amp;"). $blog.tagline is NOT
## pre-escaped (WeblogWrapper#getTagline only sanitizes/strips markup), so
## that one still needs $utils.escapeHTML.
#foreach($blog in $newblogs)
    <a class="fd-blog" href="$utils.escapeHTML($blog.absoluteURL)">
        <p class="n">$blog.name</p>
        <p class="h"><span class="live" aria-hidden="true"></span>$utils.escapeHTML($blog.handle)</p>
        #if($utils.isNotEmpty($blog.tagline))
        <p class="desc">$utils.escapeHTML($blog.tagline)</p>
        #end
    </a>
#end
</div>
#end

<div class="fd-feed">
    <a href='$url.feed.entries.atom' title='Combined Atom feed for site.'>Subscribe to the combined Atom feed</a>
</div>

## It searches entries across every weblog, not the weblogs themselves.
<div class="fd-search">
    <h2 class="fd-label">Search all posts</h2>
    #showWeblogSearchForm($model.weblog false)
</div>

#includeTemplate($model.weblog "_footer")
