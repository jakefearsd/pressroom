<weblogtheme>

    <id>travel</id>
    <name>Travel Guide</name>
    <description>Light, readable travel-guide layout: entry cards with a hero
        image and excerpt on the front page, a wide reading column on entry
        pages. Built for the [map], [faq] and [cta] shortcodes, which style
        themselves as itinerary, question and booking blocks here.</description>
    <author>Pressroom Weblogger</author>

    <!-- theme preview image -->
    <preview-image path="travel-preview.png" />

    <!-- stylesheet -->
    <stylesheet>
        <name>travel-custom.css</name>
        <description>Stylesheet for Travel Guide theme</description>
        <link>travel-custom.css</link>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>travel-custom.css</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </stylesheet>

    <!-- templates -->
    <template action="weblog">
        <name>Weblog</name>
        <description>weblog</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>weblog.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="permalink">
        <name>permalink</name>
        <description>permalink</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>permalink.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="search">
        <name>searchresults</name>
        <description>searchresults</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>searchresults.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_day</name>
        <description>_day</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_day.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_page</name>
        <description>_page</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>page.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_preview</name>
        <description>_preview</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>preview.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
</weblogtheme>
