<!doctype html>
<html lang="$model.weblog.getLanguageTag()">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    ## $model.weblog.name is pre-escaped by WeblogWrapper#getName
    ## (StringEscapeUtils.escapeHtml4) -- emit it bare, or it double-encodes
    ## ("&amp;" -> "&amp;amp;"), same as frontpage/weblog.vm's $blog.name.
    ## A meta title is the whole title: the editor's search preview shows it
    ## alone, so that is what an author who fills it in is writing.
    #if($utils.isNotEmpty($model.weblogEntry.pojo.metaTitle))
    <title>#showEntryTitle($model.weblogEntry)</title>
    #else
    <title>#showEntryTitle($model.weblogEntry) — $model.weblog.name</title>
    #end
    <link href="$url.absoluteSite/favicon.svg" rel="icon" type="image/svg+xml" />
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    <link rel="stylesheet" href="$model.weblog.stylesheet">
    #showSeoHead()
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showEmbedAssets()
    #showAudienceAssets()
    #showMapAssets()
    #showContentAssets()
</head>
<!-- permalink -->
<body class="tg">
<a class="tg-skip" href="#main">Skip to content</a>

<header class="tg-header">
    <p class="tg-name"><a href="$url.home">$model.weblog.name</a></p>
    <nav class="tg-nav">
        #showWeblogCategoryLinksList()
        <ul>
        #showPageLinks($model.weblog)
        </ul>
    </nav>
</header>

<main class="tg-main tg-main-entry" id="main">
    #set($pager = $model.getWeblogEntriesPager())
    #showWeblogEntriesPager($pager)

    #showComments($model.weblog $model.weblogEntry)

    ## Journal's reading-view steps: each neighbour on its own line with its
    ## real title, where the showNextPrevEntriesControl macro cut it to 15-20
    ## characters. Older on the left, newer on the right. Titles are stored
    ## HTML-escaped (EntryBean.copyTo), so they are emitted bare.
    #set($older = $pager.prevEntry)
    #set($newer = $pager.nextEntry)
    #if($older || $newer)
    <nav class="tg-pager tg-steps" aria-label="More entries">
        #if($older)
        <a class="tg-step tg-step-back" href="$url.entry($older.anchor)" rel="prev">
            <span class="tg-step-label">$text.get("pager.older")</span>
            <span class="tg-step-title">$older.title</span>
        </a>
        #else
        <span class="tg-step tg-step-empty"></span>
        #end
        #if($newer)
        <a class="tg-step tg-step-fwd" href="$url.entry($newer.anchor)" rel="next">
            <span class="tg-step-label">$text.get("pager.newer")</span>
            <span class="tg-step-title">$newer.title</span>
        </a>
        #end
    </nav>
    #end
</main>

<footer class="tg-footer">
    <form class="tg-search" role="search" method="get" action="$url.search">
        <input type="search" name="q" placeholder="Search guides" aria-label="$text.get("macro.weblog.searchbutton")">
    </form>
    #showSubscribeForm($model.weblog "Get new guides by email")
    #showBusinessCard($model.weblog "Book a stay")
</footer>

</body>
</html>
