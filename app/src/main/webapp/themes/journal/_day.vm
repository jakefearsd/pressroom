## $model here is a PageModel
## $entry here is a WeblogEntryWrapper
##
## Quiet Journal day fragment. On the entry list (home page, search results)
## it emits the date-marginalia qj-entry row. On the permalink page
## ($model.permalink) it emits the reading view instead -- crumb, serif
## qj-h1, byline with the mono date, then the entry body inside the qj-prose
## reading column (58ch measure, blockquotes styled as the pull-quote
## treatment; see journal-custom.css) -- per
## docs/design/journal/journal-permalink.html.
<!-- _day -->
#if($model.permalink)
    #foreach($entry in $entries)
    <article class="qj-reading">
        ## Category only. The weblog's name is already the first thing on the
        ## page -- one line above, in qj-head, and itself a link home -- so
        ## repeating it here next to the category nav stated the same thing
        ## three times inside 100px.
        ## Linked, not plain text: the crumb is the only route from a
        ## reading view back to the rest of that category, and the
        ## .qj-crumb a rule in journal-custom.css was written for a link
        ## that had never been emitted.
        <p class="qj-crumb"><a href="$url.category($entry.category.name)">$utils.escapeHTML($entry.category.name)</a></p>
        ## The reading view's own title is the page's h1 (the weblog name in
        ## the header steps down to a paragraph here), so a "##" heading in
        ## the post body is an h2 beneath it rather than its equal.
        <h1 class="qj-h1">$entry.title</h1>
        <p class="qj-byline">
            <span>By $utils.escapeHTML($entry.creator.screenName)</span>
            <time class="d" datetime="$utils.formatIso8601Day($entry.pubTime)">$utils.formatDate($entry.pubTime, "MMMM d, yyyy")</time>
            ## Travel and portfolio have always offered this; the page cache is
            ## keyed per user (WeblogPageCache), so a reader never gets it.
            #if($utils.isUserAuthorizedToAuthor($entry.website))
            <a class="qj-edit" href="$url.editEntry($entry.anchor)">$text.get("generic.edit")</a>
            #end
        </p>
        <div class="qj-prose">$entry.displayContent</div>
        ## Last thing in the reading view, after the prose: a reader who has
        ## just finished the piece is the one looking for more of the subject.
        ## $url.tag builds /<handle>/tags/<tag>, which renders through
        ## weblog.vm (the default-template fallback) with a "Tagged" heading.
        #if(!$entry.tags.isEmpty())
        <p class="qj-tags">#showEntryTags($entry)</p>
        #end
    </article>
    #end
#else
#foreach($entry in $entries)
<article class="qj-entry">
    ## "MMM d", not "MMM dd": the zero-padded form ("Mar 04") is a machine's
    ## way of writing a date. The ISO value a machine actually wants is on the
    ## <time> element, where it belongs.
    <p class="qj-date"><time datetime="$utils.formatIso8601Day($entry.pubTime)">$utils.formatDate($entry.pubTime, "MMM d")<br><span class="y">$utils.formatDate($entry.pubTime, "yyyy")</span></time></p>
    <div>
        <h2 class="qj-title"><a href="$url.entry($entry.anchor)">$entry.title</a></h2>
        ## Every row gets a line of prose. The search description is the author's
        ## own summary and wins when set, but most entries never get one, and a
        ## row that collapses to a bare title breaks the list's rhythm -- two of
        ## eight rows were half the height of their neighbours before this
        ## fallback existed. removeHTML first: displayContent is rendered markup,
        ## and truncating that directly can cut inside a tag.
        #if($utils.isNotEmpty($entry.searchDescription))
        <p class="qj-sum">$utils.escapeHTML($entry.searchDescription)</p>
        #else
        ## Emitted bare, unlike the searchDescription branch above. displayContent
        ## is already-rendered, already-sanitized HTML, so removeHTML returns text
        ## whose entities are already escaped ("I don&#39;t know"). Running
        ## escapeHTML over that escapes the ampersands a second time and the
        ## reader sees the entity source instead of the apostrophe.
        <p class="qj-sum">$utils.truncateNicely($utils.removeHTML($entry.displayContent), 120, 165, "…")</p>
        #end
        ## No "In" prefix and no <b>: the category is the least important thing
        ## in the row, and emphasising it made the only colour on the page point
        ## at the metadata rather than the writing. The accent belongs to the
        ## title's hover state, which is the one thing here you can act on.
        <p class="qj-meta">$utils.escapeHTML($entry.category.name)</p>
    </div>
</article>
#end
#end
