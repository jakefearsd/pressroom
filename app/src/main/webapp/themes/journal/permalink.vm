<!doctype html>
<html lang="$model.weblog.getLanguageTag()">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; font-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    ## $model.weblog.name is pre-escaped by WeblogWrapper#getName
    ## (StringEscapeUtils.escapeHtml4) -- emit it bare, or it double-encodes
    ## ("&amp;" -> "&amp;amp;"), same as frontpage/weblog.vm's $blog.name.
    ## A meta title is the whole title: the editor's search preview shows it
    ## alone, so that is what an author who fills it in is writing.
    #if($utils.isNotEmpty($model.weblogEntry.pojo.metaTitle))
    <title>#showEntryTitle($model.weblogEntry)</title>
    #else
    <title>#showEntryTitle($model.weblogEntry) — $model.weblog.name</title>
    #end
    <link href="$url.absoluteSite/favicon.svg" rel="icon" type="image/svg+xml" />
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    <link rel="stylesheet" href="$model.weblog.stylesheet">
    #showSeoHead()
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showEmbedAssets()
    #showAudienceAssets()
    #showMapAssets()
    #showContentAssets()
</head>
<!-- permalink -->
<body class="qj">
<a class="qj-skip" href="#main">Skip to content</a>

<header class="qj-head">
    <p class="qj-site"><a href="$url.home">$model.weblog.name</a></p>
    <nav class="qj-nav">
        #showWeblogCategoryLinksList()
        <ul>
        #showPageLinks($model.weblog)
        </ul>
    </nav>
</header>

<main class="qj-main qj-main-entry" id="main">
    #set($pager = $model.getWeblogEntriesPager())
    #showWeblogEntriesPager($pager)

    #showComments($model.weblog $model.weblogEntry)

    ## Rendered here rather than through #showNextPrevEntriesControl, which
    ## emits a single "&laquo; a | Main | b &raquo;" line and truncates each
    ## neighbour's title to 15-20 characters ("Why We Stopped Publi..."). That
    ## is right for a one-line strip and wrong for a reading view, where the
    ## neighbour deserves its own line and its real title. The pager's
    ## prevEntry/nextEntry accessors exist for exactly this.
    ##
    ## Older on the left, newer on the right, reading order matching time's
    ## direction. Titles are stored HTML-escaped (EntryBean.copyTo), so they
    ## are emitted bare like every other $entry.title in this theme.
    #set($older = $pager.prevEntry)
    #set($newer = $pager.nextEntry)
    #if($older || $newer)
    <nav class="qj-pager qj-steps" aria-label="More entries">
        #if($older)
        <a class="qj-step qj-step-back" href="$url.entry($older.anchor)" rel="prev">
            <span class="qj-step-label">$text.get("pager.older")</span>
            <span class="qj-step-title">$older.title</span>
        </a>
        #else
        <span class="qj-step qj-step-empty"></span>
        #end
        #if($newer)
        <a class="qj-step qj-step-fwd" href="$url.entry($newer.anchor)" rel="next">
            <span class="qj-step-label">$text.get("pager.newer")</span>
            <span class="qj-step-title">$newer.title</span>
        </a>
        #end
    </nav>
    #end
</main>

<footer class="qj-footer">
    <form class="qj-search" role="search" method="get" action="$url.search">
        <input type="search" name="q" placeholder="Search the journal" aria-label="$text.get("macro.weblog.searchbutton")">
    </form>
    #showSubscribeForm($model.weblog "Get new entries by email")
    #showBusinessCard($model.weblog "Book a stay")
</footer>

</body>
</html>
