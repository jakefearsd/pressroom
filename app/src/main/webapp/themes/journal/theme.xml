<weblogtheme>

    <id>journal</id>
    <name>Quiet Journal</name>
    <description>Reading-first entry list with date marginalia; the neutral
        default theme. Serif titles, a teal hover spine, and a quiet layout
        for a working journal, in light and dark, with self-hosted IBM Plex
        Serif/Sans/Mono.</description>
    <author>Pressroom Weblogger</author>

    <!-- theme preview image -->
    <preview-image path="journal-preview.png" />

    <!-- stylesheet -->
    <stylesheet>
        <name>journal-custom.css</name>
        <description>Stylesheet for Quiet Journal theme</description>
        <link>journal-custom.css</link>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>journal-custom.css</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </stylesheet>

    <!-- templates -->
    <template action="weblog">
        <name>Weblog</name>
        <description>weblog</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>weblog.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="permalink">
        <name>permalink</name>
        <description>permalink</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>permalink.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="search">
        <name>searchresults</name>
        <description>searchresults</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>searchresults.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_day</name>
        <description>_day</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>_day.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_page</name>
        <description>_page</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>page.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>

    <template action="custom">
        <name>_preview</name>
        <description>_preview</description>
        <navbar>false</navbar>
        <hidden>true</hidden>
        <contentType>text/html</contentType>
        <rendition>
            <contentsFile>preview.vm</contentsFile>
            <templateLanguage>velocity</templateLanguage>
        </rendition>
    </template>
</weblogtheme>
