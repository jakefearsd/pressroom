<!doctype html>
<html lang="$model.weblog.getLanguageTag()">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; font-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'">
    ## $model.weblog.name is pre-escaped by WeblogWrapper#getName
    ## (StringEscapeUtils.escapeHtml4) -- emit it bare, or it double-encodes
    ## ("&amp;" -> "&amp;amp;"), same as frontpage/weblog.vm's $blog.name.
    ## The category and the tag views render through this same template and
    ## used to share its title, so a reader with several tabs open -- or a
    ## bookmark -- could not tell them apart. $model.weblogCategory.name comes
    ## back RAW from WeblogCategoryWrapper#getName and is escaped here; the tag
    ## list is joined by hand because List#toString would put its brackets into
    ## the title (the same bug #showAutodiscoveryLinks fixed for its own).
    #if($model.weblogCategory)
    <title>$utils.escapeHTML($model.weblogCategory.name) : $model.weblog.name</title>
    #elseif($model.tags && !$model.tags.isEmpty())
    #set($tagTitle = "")
    #foreach($titleTag in $model.tags)#if($tagTitle != "")#set($tagTitle = "${tagTitle}, ")#end#set($tagTitle = "${tagTitle}${titleTag}")#end
    <title>Tagged $utils.escapeHTML($tagTitle) : $model.weblog.name</title>
    #else
    <title>$model.weblog.name</title>
    #end
    <link href="$url.absoluteSite/favicon.svg" rel="icon" type="image/svg+xml" />
    #showAutodiscoveryLinks($model.weblog)
    #showAnalyticsTrackingCode($model.weblog)
    <link rel="stylesheet" href="$model.weblog.stylesheet">
    #showSeoHead()
    #showGalleryGridStyles()
    #showGalleryAssets()
    #showEmbedAssets()
    #showAudienceAssets()
    #showMapAssets()
    #showContentAssets()
</head>
<!-- weblog -->
<body class="qj">
<a class="qj-skip" href="#main">Skip to content</a>

<header class="qj-head">
    <h1 class="qj-site"><a href="$url.home">$model.weblog.name</a></h1>
    #if($utils.isNotEmpty($model.weblog.tagline))
    <p class="qj-tagline">$utils.escapeHTML($model.weblog.tagline)</p>
    #end
    <nav class="qj-nav">
        #showWeblogCategoryLinksList()
        <ul>
        #showPageLinks($model.weblog)
        </ul>
    </nav>
</header>

<main class="qj-main" id="main">
    #set($pager = $model.getWeblogEntriesPager())
    ## An entry list with nothing in it rendered as blank space, on the home
    ## page, on a category nobody has filed under, and on a tag page reached
    ## from a stale link. The wording differs per view because "nothing here
    ## yet" means three different things to the reader in those three places.
    #set($pagerDays = $pager.getEntries())
    <div class="qj-entries">
        #if($pagerDays.isEmpty())
        #if($model.weblogCategory)
        <p class="qj-list-empty">Nothing has been filed under this category yet.</p>
        #elseif($model.tags && !$model.tags.isEmpty())
        <p class="qj-list-empty">No entries carry that tag yet.</p>
        #else
        <p class="qj-list-empty">Nothing has been published here yet. The first entry will appear on this page.</p>
        #end
        #else
        #showWeblogEntriesPager($pager)
        #end
    </div>
    ## Same treatment as the permalink's entry-to-entry navigation, for the same
    ## reason: #showNextPrevEntriesControl emits "&laquo; a | Main | b &raquo;",
    ## which is furniture from a different decade. Here the links are pages of
    ## the archive rather than single entries, so the labels name the direction
    ## and the pager supplies nothing worth printing as a title.
    #if($pager.prevLink || $pager.nextLink)
    <nav class="qj-pager qj-steps" aria-label="More entries">
        ## getPrevLink() moves toward the present (newer entries); getNextLink()
        ## moves further back through the archive (older entries) --
        ## AbstractWeblogEntriesPager.java:146-178. The rel attributes below
        ## already track that correctly and must not move; only the label and
        ## the qj-step-back/qj-step-fwd grid-column class (older stays visually
        ## left) are tied to the correct link here.
        #if($pager.prevLink)
        <a class="qj-step qj-step-fwd" href="$pager.prevLink" rel="prev">
            <span class="qj-step-label">Newer</span>
            <span class="qj-step-title">More recent entries</span>
        </a>
        #else
        <span class="qj-step qj-step-empty"></span>
        #end
        #if($pager.nextLink)
        <a class="qj-step qj-step-back" href="$pager.nextLink" rel="next">
            <span class="qj-step-label">Older</span>
            <span class="qj-step-title">Earlier entries</span>
        </a>
        #end
    </nav>
    #end
</main>

<footer class="qj-footer">
    <form class="qj-search" role="search" method="get" action="$url.search">
        <input type="search" name="q" placeholder="Search the journal" aria-label="Search">
    </form>
    #showSubscribeForm($model.weblog "Get new entries by email")
    #showBusinessCard($model.weblog "Book a stay")
</footer>

</body>
</html>
