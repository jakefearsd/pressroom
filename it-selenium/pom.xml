<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wikantik.pressroom</groupId>
        <artifactId>pressroom-project</artifactId>
        <version>0.4.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pressroom-selenium-tests</artifactId>
    <name>Roller browser integration tests</name>
    <description>
        Selenide integration tests. The executable Roller WAR (Spring Boot 4,
        embedded Tomcat) is launched as a subprocess by start-app.sh against a
        dedicated PostgreSQL container whose schema is built by the real
        bin/db/migrations chain. Every test inherits browser-health checking, so a page
        that renders while its assets 404 fails rather than passing.

        Runs under `mvn verify -Pit`; excluded from the default build because it costs
        minutes rather than seconds.
    </description>

    <properties>
        <!-- Versions match the sibling jspwiki/wikantik Selenide suite. -->
        <selenide.version>7.19.0</selenide.version>
        <selenium.version>4.51.0</selenium.version>
        <!-- Raised past selenide-core's transitive 5.6.2, which leaks a pooled
             connection whenever a response carries an unsupported
             Content-Encoding (CVE-2026-64607, pool-exhaustion DoS). This suite
             only ever talks to our own test server, so this is hygiene rather
             than exposure - but it costs a pin. Enforced by
             DependencySecurityFloorTest over in app's fast suite, which reads
             this file's text: this module has no unit tests of its own and
             builds only under -Pit, so a floor asserted here would go unchecked
             on the push path. -->
        <httpclient5.version>5.6.5</httpclient5.version>
        <!-- This module isn't a Spring Boot artifact and imports no BOM, so
             junit-jupiter needs an explicit pin (app/pom.xml gets its JUnit
             version for free from Spring Boot's dependencyManagement import;
             this module doesn't). Kept in step with app's resolved
             junit-jupiter version (JUnit 6). When bumping app/pom.xml's
             spring-boot.version, re-check what junit-jupiter version its BOM
             now resolves to and update this pin to match:
               mvn -ntp -pl app dependency:tree -Dincludes=org.junit.jupiter:junit-jupiter-api
             (currently resolves to 6.1.3 via app's junit-bom import, matching the pin below). -->
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <docker.plugin.version>0.49.0</docker.plugin.version>
        <build-helper.version>3.6.2</build-helper.version>
        <exec.plugin.version>3.6.4</exec.plugin.version>
        <!-- app-stop only; see the plugin comment below for why it cannot share the
             exec-maven-plugin declaration used for app-start and the pg-* steps. -->
        <antrun.plugin.version>3.2.0</antrun.plugin.version>

        <it.db.name>pressroom_it</it.db.name>
        <it.db.user>pressroom</it.db.user>
        <it.db.password>pressroom</it.db.password>
        <it.db.container-alias>roller-it-postgres</it.db.container-alias>
        <it.postgres.image>postgres:18</it.postgres.image>

        <!-- The OIDC provider SsoSignInIT signs readers in through. It joins
             PostgreSQL under docker-maven-plugin (pg-start starts every image
             below, pg-stop stops and removes every one), imports the realm in
             src/test/resources/keycloak/roller-it-realm.json, and listens on the
             reserved ${it.kc.port}; roller-it.properties points the app's
             sso.oidc.* at it, so SSO is on for the whole IT suite.

             The alias must be what it-harness-lib.sh derives from the
             postgres prefix (IT_KC_CONTAINER_PREFIX), or the sweep cannot
             find a container an aborted run left behind. -->
        <it.keycloak.image>quay.io/keycloak/keycloak:26.0</it.keycloak.image>
        <it.kc.container-alias>roller-it-keycloak</it.kc.container-alias>

        <!-- The bare context segment the app under test is deployed under.
             EMPTY = the root, which is what application.properties now ships
             (server.servlet.context-path=/). The suite must track the shipped
             default, not pin a prefix production does not use.

             it.base.url below therefore ends in a trailing slash at the root;
             PressroomIT.baseUrl() strips one, which is why that is harmless and
             why this can stay a plain string substitution.

             `mvn verify -Pit -Dit.context.path=roller` runs the entire suite
             under /roller instead. That is the ONLY end-to-end coverage of the
             non-root case (the unit tests cover the url-building rules at both
             contexts, but only a real container proves the servlet mappings,
             the security chain and the rendering forwards survive a prefix), so
             run it before shipping anything that touches routing. -->
        <it.context.path/>

        <!-- How many test CLASSES, and therefore how many Chromes, run at
             once. The default matches junit-platform.properties' own value and
             is tuned for a developer machine; see that file for the reasoning.

             It is a property rather than a constant because the number is a
             statement about the MACHINE, not about the suite, and CI runs on a
             much smaller one. A GitHub-hosted runner inherited the 16-core
             default silently until the runner image moved from
             ubuntu24/20260810.271 to 20260816.277, after which the nightly
             failed every night: Chrome renderer timeouts scattered across a
             different handful of classes each run, several reported with a
             negative remaining deadline (the command's timeout had expired
             before the browser was scheduled at all), which is starvation
             rather than a slow page. .github/workflows/main.yml passes a lower
             value; ItCiWorkflowTest pins that it does.

             Overriding it on the command line only works because failsafe
             forwards it into the forked JVM as a JUnit configuration
             parameter (see systemPropertyVariables below); a -D on the Maven
             command line does not reach a forked JVM by itself, and
             junit-platform.properties would win. -->
        <it.parallelism>4</it.parallelism>

        <!-- Whether classes run concurrently AT ALL. True locally, false in
             CI, and the split exists because it.parallelism above turned out
             not to bound anything.

             JUnit's fixed strategy treats parallelism as a TARGET for a
             ForkJoinPool, not a cap: the pool compensates for blocked tasks
             by spawning more threads, and a Selenium test blocks on nearly
             every line. Measured here, -Dit.parallelism=1 still ran four IT
             classes concurrently (about 17s wall clock for four classes of
             about 10s each, rather than 40s), and a CI run with
             -Dit.parallelism=2 started 24 classes inside four seconds. So the
             number shapes the local run loosely and guarantees nothing.

             Disabling parallel execution is a different code path with no
             pool in it, which is why this is the knob CI uses. It costs the
             nightly wall clock (roughly 14 minutes of test time rather than
             8) against a 45-minute timeout, on a job that runs overnight. -->
        <it.parallel.enabled>true</it.parallel.enabled>

        <!-- ONE ID PER RUN, stamped into every process, file, directory and
             container this module creates. It is what makes cleanup
             identity-based rather than pidfile-based: an app JVM carries it as
             -Dpressroom.it.run=<id> on its command line, so it can be found again
             after any file has been lost, and a container carries it in its
             name, so "whose is this?" always has an answer. See
             src/test/script/it-harness-lib.sh.

             Timestamp plus the reserved HTTP port: the timestamp separates
             sequential runs (whose ports may repeat), the port separates
             concurrent ones (which share a second). -->
        <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>
        <it.build.timestamp>${maven.build.timestamp}</it.build.timestamp>
        <it.run.id>${it.build.timestamp}-${it.http.port}</it.run.id>

        <!-- Per-run, never shared. A single fixed app.pid was truncated by
             every run, so run N+1 destroyed the only record of run N's leaked
             JVM; a single fixed app.log destroyed its diagnostics the same
             way. start-app.sh symlinks it-work/app-latest.log at the newest
             one for convenience. -->
        <it.work.dir>${project.build.directory}/it-work</it.work.dir>
        <it.app.war>${project.basedir}/../app/target/roller.war</it.app.war>
        <it.app.pidfile>${it.work.dir}/app-${it.run.id}.pid</it.app.pidfile>
        <it.app.log>${it.work.dir}/app-${it.run.id}.log</it.app.log>
        <it.db.container-name>${it.db.container-alias}-${it.run.id}</it.db.container-name>
        <it.kc.container-name>${it.kc.container-alias}-${it.run.id}</it.kc.container-name>
    </properties>

    <!-- A property alone would not move httpclient5: it arrives transitively via
         selenide-core, so its own declared version wins unless something manages
         it. This entry is what makes the pin above effective. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.codeborne</groupId>
            <artifactId>selenide</artifactId>
            <version>${selenide.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Browser-health checks read sub-resource status codes over the Chrome
             DevTools Protocol; Selenium 4's W3C API does not expose them. Pin the
             bindings rather than taking them transitively, so a Selenium bump that
             drops this version fails the build instead of failing at runtime.
             That is not theoretical: 4.49.0 drops v150, which 4.47.0 shipped.

             KEEP THIS AT THE NEWEST VERSION THE PINNED SELENIUM SHIPS. CDP
             bindings tolerate a couple of Chrome majors of drift, and Selenium
             falls back to the nearest it has, but the fallback is silent and a
             blind Network domain makes every BrowserHealth check pass vacuously
             rather than fail. Under 4.47.0 this said v150 while that same Selenium
             already shipped v151 and the local Chrome spoke 152: two majors
             of drift that nothing reported beyond a log line. 4.51.0 ships
             v153/v154/v155, and v155 is both the newest it has and what the
             Chrome on this machine speaks (2026-10-17). Chrome moved 152 to
             153 during the afternoon the first pin was written, which is the
             cadence to expect.
             BrowserHealth's own blindness check is the backstop for when Chrome
             moves past it again. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-devtools-v155</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- McpIT parses JSON-RPC responses. This module imports no BOM, so
             the version is pinned here, matching the tools.jackson line app
             resolves (app/pom.xml's jackson3.security.version). -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.4</version>
            <scope>test</scope>
        </dependency>

        <!-- Not consumed directly (start-app.sh reads app/target/roller.war off
             the filesystem, not via Maven artifact resolution): declared purely
             to force Maven reactor build order. Without a real inter-module
             dependency, `mvn verify -Pit` from the repo root has no guarantee
             app builds (and spring-boot:repackage rewrites roller.war into the
             executable jar-in-war start-app.sh needs) before this module's
             pre-integration-test phase runs. -->
        <dependency>
            <groupId>com.wikantik.pressroom</groupId>
            <artifactId>pressroom</artifactId>
            <version>${project.version}</version>
            <type>war</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- roller-it.properties (Roller's own -Dpressroom.custom.config overlay, read by
             start-app.sh) needs ${it.db.port}, ${it.db.name}, ${project.basedir}, and
             ${project.build.directory} substituted; filtering is off by default for
             testResources, so it must be turned on explicitly here. seed-it-data.sql
             lives in the same directory and has no ${...} tokens of its own, so
             filtering the whole directory is harmless. -->
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>

        <plugins>

            <!-- Reserve free ports so a developer's local PostgreSQL on 5432, or the
                 dev server (./roller dev, spring-boot:run) on 8083, cannot collide
                 with a test run. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper.version}</version>
                <executions>
                    <execution>
                        <id>reserve-it-ports</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>reserve-network-port</goal>
                        </goals>
                        <configuration>
                            <portNames>
                                <portName>it.db.port</portName>
                                <portName>it.http.port</portName>
                                <portName>it.kc.port</portName>
                            </portNames>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Everything that must bracket docker-maven-plugin, via
                 maven-antrun-plugin rather than exec-maven-plugin (which does the
                 launching below): Maven runs same-phase executions in the order their
                 owning <plugin> elements appear in this file, so a plugin declared
                 before docker-maven-plugin wins both ends of the race: its
                 pre-integration-test executions run before pg-start, and its
                 post-integration-test app-stop runs before pg-stop, which matters
                 because the app (and its DB connections) must be gone before the
                 container it is talking to. exec-maven-plugin cannot be reused for
                 this: it already appears later in this file (bound to
                 pre-integration-test, where its executions must instead run AFTER
                 pg-start), and declaring the same plugin GAV twice does not give two
                 independently-positioned instances: Maven merges duplicate <plugin>
                 declarations into one, scheduled at the position of the *first*
                 occurrence, which would then run every exec-maven-plugin execution
                 (including the pre-integration-test ones declared in the second block)
                 before docker-maven-plugin's pg-start. Confirmed via
                 `mvn help:effective-pom`: the merge silently reorders pg-wait-ready
                 ahead of pg-start. A different plugin artifact avoids the merge
                 entirely. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${antrun.plugin.version}</version>
                <executions>
                    <!-- FIRST thing in the phase, before a container exists: reap what
                         earlier runs leaked and report it. Nothing else in this build
                         detects staleness, because build-helper hands out a free port every
                         run, so leaked app servers never collide and the suite passes
                         over the top of them, which is how they accumulated unnoticed. -->
                    <execution>
                        <id>it-sweep-stale</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/src/test/script/sweep-stale.sh" failonerror="true">
                                    <arg value="${it.run.id}"/>
                                    <arg value="${it.work.dir}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Started before pg-start, so it covers every abort from here on:
                         a pg-wait-ready timeout, a migrate.sh or seed failure, an
                         app-start timeout, or a Ctrl-C. None of those reach
                         post-integration-test, where the ordinary cleanup lives. It
                         detaches immediately and outlives the build. -->
                    <execution>
                        <id>it-supervisor</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/src/test/script/supervise-run.sh" failonerror="true">
                                    <arg value="${it.run.id}"/>
                                    <arg value="${it.db.container-name}"/>
                                    <arg value="${it.work.dir}"/>
                                    <arg value="${it.kc.container-name}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>app-stop</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/src/test/script/stop-app.sh" failonerror="true">
                                    <arg value="${it.app.pidfile}"/>
                                    <arg value="${it.run.id}"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <version>${docker.plugin.version}</version>
                <configuration>
                    <images>
                        <image>
                            <alias>${it.db.container-alias}</alias>
                            <name>${it.postgres.image}</name>
                            <run>
                                <!-- Per-run name, not the bare alias: two runs on one
                                     machine used to collide on a single fixed container
                                     name (a 409 from the daemon, which CLAUDE.md told
                                     operators to clear by hand), and a fixed name gives
                                     the sweep no way to tell a corpse from a concurrent
                                     run's live container. -->
                                <containerNamePattern>${it.db.container-name}</containerNamePattern>
                                <ports>
                                    <port>${it.db.port}:5432</port>
                                </ports>
                                <env>
                                    <POSTGRES_USER>${it.db.user}</POSTGRES_USER>
                                    <POSTGRES_PASSWORD>${it.db.password}</POSTGRES_PASSWORD>
                                    <POSTGRES_DB>${it.db.name}</POSTGRES_DB>
                                </env>
                                <!-- The log line alone is not enough: the postgres image
                                     prints it once for its unix-socket-only init server
                                     before restarting to listen on TCP, so a log-only
                                     wait returns while the mapped port still refuses
                                     connections. Wait on the port as well. -->
                                <wait>
                                    <log>database system is ready to accept connections</log>
                                    <tcp>
                                        <mode>mapped</mode>
                                        <ports>
                                            <port>5432</port>
                                        </ports>
                                    </tcp>
                                    <time>60000</time>
                                </wait>
                            </run>
                        </image>
                        <!-- Keycloak for SsoSignInIT; modelled on Wikantik's SSO IT
                             module. Named per run like postgres, and handed to the
                             supervisor, so an aborted run cannot leak it. The image
                             declares no VOLUME and the realm is a read-only bind, so
                             pg-stop's removeVolumes leaves nothing behind for it
                             either. Waited on through the realm's own discovery
                             document: that answers only once the import is done,
                             which a port or health check does not prove. -->
                        <image>
                            <alias>${it.kc.container-alias}</alias>
                            <name>${it.keycloak.image}</name>
                            <run>
                                <containerNamePattern>${it.kc.container-name}</containerNamePattern>
                                <cmd>start-dev --import-realm --http-port=8080</cmd>
                                <env>
                                    <KC_HEALTH_ENABLED>true</KC_HEALTH_ENABLED>
                                </env>
                                <ports>
                                    <port>${it.kc.port}:8080</port>
                                </ports>
                                <volumes>
                                    <bind>
                                        <volume>${project.basedir}/src/test/resources/keycloak:/opt/keycloak/data/import:ro</volume>
                                    </bind>
                                </volumes>
                                <wait>
                                    <http>
                                        <url>http://localhost:${it.kc.port}/realms/roller-it/.well-known/openid-configuration</url>
                                        <method>GET</method>
                                        <status>200</status>
                                    </http>
                                    <time>120000</time>
                                </wait>
                            </run>
                        </image>
                    </images>
                </configuration>
                <executions>
                    <execution>
                        <id>pg-start</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>start</goal></goals>
                    </execution>
                    <execution>
                        <id>pg-stop</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>stop</goal></goals>
                        <configuration>
                            <!-- postgres:18 declares VOLUME /var/lib/postgresql (16 and
                                 earlier declared /var/lib/postgresql/data), so
                                 Docker creates an anonymous volume for every IT run.
                                 removeVolumes defaults to false, which means a
                                 *successful* run also orphaned one: the only leak here
                                 that did not need an abort to happen. -->
                            <removeVolumes>true</removeVolumes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- pg-wait-ready / pg-apply-migrations / pg-seed-it-data / app-start: all
                 pre-integration-test, all must run after docker-maven-plugin's pg-start,
                 which is why this plugin is declared after it. See the app-stop
                 (maven-antrun-plugin) comment above for why app-stop is not simply a
                 fifth execution in this same block. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <!-- Belt and braces on top of the docker tcp wait: the port can be
                         open a moment before the server will answer queries, and
                         migrate.sh fails fast rather than retrying. Executions in the
                         same phase run in declaration order, so this must stay first. -->
                    <execution>
                        <id>pg-wait-ready</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>for i in $(seq 1 60); do pg_isready -h localhost -p ${it.db.port} -U ${it.db.user} -d ${it.db.name} -t 1 &amp;&amp; exit 0; sleep 1; done; echo "pg_isready timed out after 60s" &gt;&amp;2; exit 1</argument>
                            </arguments>
                            <environmentVariables>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Schema comes from the same migration chain production uses.
                         There is deliberately no test-specific DDL to drift. -->
                    <execution>
                        <id>pg-apply-migrations</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${project.basedir}/../bin/db/migrate.sh</executable>
                            <environmentVariables>
                                <DB_NAME>${it.db.name}</DB_NAME>
                                <DB_APP_USER>${it.db.user}</DB_APP_USER>
                                <PGHOST>localhost</PGHOST>
                                <PGPORT>${it.db.port}</PGPORT>
                                <PGUSER>${it.db.user}</PGUSER>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Seeds the admin user, weblog and category the sweep logs in
                         with. Must run before Tomcat starts: Roller caches
                         aggressively in-process. -->
                    <execution>
                        <id>pg-seed-it-data</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>psql</executable>
                            <arguments>
                                <argument>-v</argument><argument>ON_ERROR_STOP=1</argument>
                                <argument>-h</argument><argument>localhost</argument>
                                <argument>-p</argument><argument>${it.db.port}</argument>
                                <argument>-U</argument><argument>${it.db.user}</argument>
                                <argument>-d</argument><argument>${it.db.name}</argument>
                                <argument>-f</argument>
                                <argument>${project.basedir}/src/test/resources/seed-it-data.sql</argument>
                            </arguments>
                            <environmentVariables>
                                <PGPASSWORD>${it.db.password}</PGPASSWORD>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <!-- Launches the executable WAR (java -jar, embedded Tomcat) as a
                         background process and blocks until roller-ui/login.rol answers
                         or 180s elapse; the same readiness contract cargo's pingURL
                         enforced, now against a subprocess instead of a container-managed
                         Tomcat. Must run after pg-seed-it-data: Roller caches the seed
                         data aggressively in-process at startup, so seeding after the app
                         is already up would leave it looking at a stale view. See
                         start-app.sh for the WAR-not-found fast-fail message that points
                         at running the full reactor rather than this module alone. -->
                    <execution>
                        <id>app-start</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${project.basedir}/src/test/script/start-app.sh</executable>
                            <!-- Passed as an environment variable rather than a
                                 positional argument specifically because it is
                                 empty by default, and an empty argument element
                                 is not reliably delivered as an empty argv slot;
                                 it would silently shift every later argument by
                                 one. The script defaults it the same way. -->
                            <environmentVariables>
                                <IT_CONTEXT_PATH>${it.context.path}</IT_CONTEXT_PATH>
                            </environmentVariables>
                            <arguments>
                                <argument>${it.app.war}</argument>
                                <argument>${it.http.port}</argument>
                                <argument>${project.build.testOutputDirectory}/roller-it.properties</argument>
                                <argument>${it.app.pidfile}</argument>
                                <argument>${it.app.log}</argument>
                                <argument>${it.run.id}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 127.0.0.1, not localhost: Tomcat binds IPv4 while Chrome resolves
                             localhost to ::1 first, so the browser gets connection-refused
                             against a server that is demonstrably listening. -->
                        <it.base.url>http://127.0.0.1:${it.http.port}/${it.context.path}</it.base.url>
                        <!-- VirtualHostIT simulates a custom domain by sending an explicit Host
                             header (there is no real DNS in this environment). java.net.http.HttpClient
                             refuses to set Host unless the JVM was started with this property;
                             it is read when the HttpClient classes initialise, so it must be set on
                             the failsafe-forked JVM itself, not from test code. -->
                        <jdk.httpclient.allowRestrictedHeaders>host</jdk.httpclient.allowRestrictedHeaders>
                        <!-- JUnit resolves configuration parameters from system
                             properties BEFORE junit-platform.properties, so this
                             is what makes -Dit.parallelism=<n> actually take
                             effect. It has to be set here, on the forked JVM,
                             rather than relying on the Maven command line: the
                             fork does not inherit it. See the it.parallelism
                             property above for why CI needs a smaller value. -->
                        <junit.jupiter.execution.parallel.config.fixed.parallelism>${it.parallelism}</junit.jupiter.execution.parallel.config.fixed.parallelism>
                        <!-- The CEILING, and the reason the parallelism above finally
                             means something. JUnit's FIXED strategy grows the pool past
                             its target to compensate for blocked threads, up to
                             fixed.max-pool-size, which DEFAULTS TO 256. A Selenium test
                             blocks on nearly every line, so it grew there almost at once:
                             that is how -Dit.parallelism=2 came to start 24 classes inside
                             four seconds. Pinned to the same property, so one number
                             decides both the target and the cap. -->
                        <junit.jupiter.execution.parallel.config.fixed.max-pool-size>${it.parallelism}</junit.jupiter.execution.parallel.config.fixed.max-pool-size>
                        <junit.jupiter.execution.parallel.enabled>${it.parallel.enabled}</junit.jupiter.execution.parallel.enabled>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
